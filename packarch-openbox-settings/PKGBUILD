# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Openbox configuration of Packarch: polybar, rofi menus, dunst,
# picom, kitty and 10 themes, switched with packarch-skin. Based on the
# Openbox configuration of Aditya Shakya (adi1090x), GPL3, with the skeleton
# files it relies on (dunst, picom, rofi, GTK, xfconf, Thunar) and the Geany
# color schemes. The configuration goes to /etc/skel (copied to the home of
# new users), with the default theme already applied to it at build time
# (packarch-skin render, 7.0-32; before, at the first login). Menus,
# pipemenus, dunst icons and the packarch-tcma (Thunar actions) and
# packarch-reload-theme commands go to /usr (packarch-openbox-extras before
# 7.0-16). /etc/lightdm/lightdm.conf.d/60-packarch-openbox.conf makes Openbox
# the default LightDM session (written by the ISO before 7.0-22). snixembed
# shows the StatusNotifierItem icons (cachy-update, nm-applet...) in the
# XEmbed tray of polybar. xdg-terminal-exec and
# /etc/xdg/xdg-terminals.list open kitty for the applications launched with
# Terminal=true (GLib does not know kitty: "Launch Cachy-Update" did nothing).
#
# Name: packarch-openbox until 7.0-71 (renamed packarch-openbox-settings in
# 7.0-72, like packarch-xfce-settings; the file names with packarch-openbox,
# 60-packarch-openbox.conf and 25_packarch-openbox.gschema.override, are kept).
#
# Our changes: French translation, 24-hour clock, numlock on, first-login
# theme application, no second xfce-polkit, Packarch names and paths
# (/usr/share/packarch, packarch-* commands, pa-* pipemenus), themes described
# in theme.toml and applied by packarch-skin (no apply.sh), kitty as the only
# terminal, nano instead of vim, no ranger, no plank dock (7.0-29), no tint2
# (7.0-30), menu items in "<font>,feather" so that the glyphs of
# menu-glyphs.xml all come from feather (same width), window list (polywins)
# in the default, adaptive, pink-city and yellow-flower themes, a second bar
# at the bottom in default and yellow-flower (application menu,
# Firefox/Thunar/kitty launchers), yellow-flower (formerly slime: Juno-Mirage,
# Ayu Mirage colors), pink-city (formerly red: Qogir-Pink-Dark icons),
# packarch (formerly manhattan: colors of packarch-default.jpg, two bars),
# hacking (formerly hack), no wave, gray, forest, kiss, easy, rainy, nord and
# beach themes, new red-satanic, pink-sylvanas and cyberpunk themes, 4
# desktops instead of 5 (7.0-30), minimized windows dimmed and in brackets in
# the window list, no backlight or battery module without the hardware, no mpd
# and Spotify scripts (music modules, rofi-music, ob-music, rofi-spotify;
# media keys use playerctl). obmenu-generator also reads
# ~/.local/share/applications (7.0-73: applications installed or hidden by the
# user, new accounts only).
# Icons (7.0-70): Packarch for the default, packarch, red-satanic,
# pink-sylvanas and yellow-flower themes, with their folder_color (blue, red,
# purple, yellow; packarch-folder-color) instead of the Luna-* themes.
# Menu (7.0-71): "Couleur des dossiers" (packarch-folder-color) in
# Préférences of menu-icons.xml and menu-glyphs.xml.
# XFCE (7.0-72): the theme.toml files are also the themes of the XFCE desktop
# (copied by packarch-xfce-settings); [xfce] xfwm4_theme = "Default" in
# hacking (Packarch-Hacking has no xfwm4 theme), packarch-skin 1.0.0-19;
# packarch-themes-openbox, packarch-icons-openbox and
# packarch-backgrounds-openbox merged into packarch-themes, packarch-icons
# and packarch-backgrounds.

# 7.0-74: Qogir-Pink-Dark icons (colors of origin) in the default theme, also
# used by packarch-xfce-settings
# 7.0-75: obmenu-generator also reads the Flatpak applications (system and
# user), for new accounts

pkgname=packarch-openbox-settings
pkgver=7.0
pkgrel=75
pkgdesc="Openbox configuration of Packarch"
arch=('any')
url="https://github.com/packarch/myrepo-pkgs"
license=('GPL3')
depends=(
  # Openbox and the tools of the configuration
  openbox obconf-qt obmenu-generator perl-linux-desktopfiles pulsemixer light
  # names of the applications menu in the user language (locale_support)
  perl-file-desktopentry
  polybar snixembed xdg-terminal-exec rofi dunst nitrogen
  xfce4-settings xmlstarlet
  python-lxml lead-git skippy-xd-git
  # optional dependencies used by the configuration (keys, menus, scripts)
  kitty thunar geany firefox viewnior betterlockscreen
  ksuperkey networkmanager-dmenu-git ffmpeg maim xclip xcolor
  xfce4-power-manager xorg-xsetroot yad picom
  # Noto Sans: GTK and Openbox fonts of the themes (7.0-39)
  noto-fonts
  # commands of the scripts and polybar modules
  xdotool wmctrl slop xorg-xprop xorg-xrandr xorg-xkill xorg-xbacklight acpi bc
  alsa-utils bluez-utils playerctl imagemagick htop nano xfce-polkit
  xdg-user-dirs python-pyxdg dconf
  # Packarch repository: theme chooser, GTK/Openbox themes, icons, cursors,
  # fonts and wallpapers; global fonts of pa-change-fonts: packarch-skin
  # font (1.0.0-11, 7.0-38); role fastfetch of red-satanic (1.0.0-12, 7.0-42).
  # 7.0-72: the -openbox packages are merged into packarch-themes,
  # packarch-icons and packarch-backgrounds (same themes on XFCE)
  'packarch-skin>=1.1.0' 'packarch-themes>=2.0-7' 'packarch-icons>=2.0-9'
  'packarch-backgrounds>=2.0-6' packarch-folder-color packarch-cursors packarch-fonts
)
# Writes the default theme into /etc/skel (render, packarch-skin 1.0.0-9)
makedepends=('packarch-skin>=1.1.0')
# Merged into this package (7.0-16); formerly packarch-openbox (renamed in
# 7.0-72, like packarch-xfce-settings)
replaces=(packarch-openbox-extras packarch-openbox)
conflicts=(packarch-openbox-extras packarch-openbox)
provides=(packarch-openbox-extras packarch-openbox)
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
	# The first session starts with the default theme: no packarch-skin apply
	# at the first login. Also writes the GSettings override of its color
	# scheme (usr/share/glib-2.0/schemas).
	packarch-skin render "$pkgdir" default
}
