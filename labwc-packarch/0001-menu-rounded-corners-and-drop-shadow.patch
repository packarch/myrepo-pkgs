+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_MENU_BACKGROUND_H
+#define LABWC_MENU_BACKGROUND_H
+#include <stdbool.h>
+
+struct wlr_scene_tree;
+struct theme;
+
+/*
+ * Packarch: true if the theme asks for rounded corners or a drop-shadow
+ * around menus (menu.corner.radius, menu.shadow.size); otherwise menus
+ * keep the plain background of labwc.
+ */
+bool menu_background_is_custom(struct theme *theme);
+
+/*
+ * Packarch: background of a menu of width x height (layout pixels), drawn
+ * in one auto-scaling buffer: border and fill with rounded corners, and a
+ * drop-shadow around them. The buffer extends menu.shadow.size beyond the
+ * menu on every side; only the menu itself accepts input.
+ */
+void menu_background_create(struct wlr_scene_tree *parent,
+	struct theme *theme, int width, int height);
+
+#endif /* LABWC_MENU_BACKGROUND_H */
