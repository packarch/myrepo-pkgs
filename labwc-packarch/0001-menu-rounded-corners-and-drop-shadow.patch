 src/menu/menu-background.c     | 191 +++++++++++++++++++++++++++++++++
 src/menu/menu.c                |   8 ++
 src/menu/meson.build           |   1 +
 src/theme.c                    |  14 +++
 6 files changed, 243 insertions(+)
 create mode 100644 include/menu/menu-background.h
 create mode 100644 src/menu/menu-background.c

