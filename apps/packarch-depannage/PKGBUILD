# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Temporary remote help of Packarch: a window (egui) starts, with the password
# of the user (pkexec), a Tailscale session with Tailscale SSH and shows the
# login link to send to the person who helps; she opens it with her
# Tailscale account and connects as root (ssh root@packarch-<host>). The
# session stops by itself (systemd timer, 1 hour, "+1 h" to extend) or with
# "Arrêter maintenant": tailscale logout, tailscaled stopped. Nothing runs
# outside a session (the tailscaled service of the system is not used); the cleanup service ends a
# session left open by a shutdown. No secret on the computer. The tailnet
# policy of the person who helps must keep tag:depannage away from her other
# devices (README).
# 0.1.1: "Dépannage en cours" from the Tailscale activity (5 minutes), with
# the account and device of the person who helps.
# 0.1.2: ephemeral node (own tailscaled instance with in-memory state):
# removed from the tailnet when the session stops.
# 0.2.0: chat between the user and the person who helps, in the window of
# both; the latter goes through ssh (openssh).
# 0.3.0: egui window instead of GTK4/libadwaita. The libraries of egui are
# loaded at startup (not visible to ldd), hence listed by hand; libnotify:
# notifications.
# 0.3.1: confirmation before closing the window during a session.
# 0.3.2: named Packarch Dépannage in the menu and the window.
# 0.3.3: version in the window title, duplicate header section removed.
# 0.3.4: session-run and info under Sway (Wayland).
# 0.3.5: labwc instead of Sway (LABWC_PID, Wayland socket of the labwc
# session), the Sway desktop of Packarch is removed.
# 0.3.6: Packarch desktop (packarch compositor: PACKARCH_PID, Wayland socket
# of the packarch session).
# 0.3.7: labwc desktop removed (Packarch only).
# 0.4.0: C++/Qt 6 (CMake) instead of Rust/egui, and two packages built from
# the same sources: packarch-depannage (helped computer, same commands as
# before over Tailscale SSH) and packarch-admin (helper: computers to help,
# embedded terminals with qtermwidget, chat, tray icon, connection keys).
# Both have the version of the tag; each takes its CMake install component.
# 0.4.1: text mode in a console (no desktop, or the window does not open);
# the window is a separate program (/usr/lib/packarch-depannage), the
# commands only need Qt Core.
# 0.4.2: the Claude Code skill (packarch-admin) follows the chat.
# 0.4.3: packarch-admin: a session opened again (same name, new address) gets
# a new page, chat and connection key.
# 0.4.4: packarch-admin: screen of the helped person (view and control) and
# information about the computer, by scripts sent over SSH (nothing more on the
# helped computer).
# 0.4.5: compact window with the Packarch logo (also the icon), emoji in the
# chat, name of the helper shown instead of the Tailscale account name.
# 0.4.6: every chat message starts with the name of its author; the Claude
# Code skill stays out of the chat unless the helper allows it.
# 0.4.7: packarch-admin tchat-suivre/tchat-dire (chat of the assistant, gated
# by the checkbox), coloured chat, animated logo in the window.
# 0.4.8: packarch-admin: one page per session, never closed by itself (a
# session opened again no longer kills the tabs of the previous one).
# 0.4.9: no password to allow the remote help for an administrator (wheel) at
# the screen (polkit rule), one polkit action per command.
# 0.4.10: packarch-depannage aur: AUR packages installed by yay as the user
# (yay as root builds in a noexec directory since systemd 262), with a temporary
# sudo rule (pacman) written by the command; hence sudo (visudo).

pkgbase=packarch-depannage
pkgname=('packarch-depannage' 'packarch-admin')
pkgver=0.4.10
pkgrel=1
arch=('x86_64')
url="https://github.com/packarch/packarch-depannage"
license=('GPL-3.0-or-later')
makedepends=('cmake' 'qt6-base' 'qtermwidget')
source=("$pkgbase-$pkgver.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
	cmake -S "$pkgbase-$pkgver" -B build \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_PREFIX=/usr
	cmake --build build
}

check() {
	ctest --test-dir build --output-on-failure
}

package_packarch-depannage() {
	pkgdesc="Temporary remote help (Tailscale SSH) for Packarch"
	# maim, xdotool, wmctrl: used by the person who helps in the session of the
	# user (screenshot, clicks, closing a window), on every desktop;
	# util-linux: runuser (session-run)
	depends=('qt6-base' 'tailscale' 'polkit' 'libnotify' 'util-linux' 'sudo'
	         'maim' 'xdotool' 'wmctrl' 'gcc-libs' 'glibc')
	optdepends=('yay: AUR packages installed by the person who helps (packarch-depannage aur)')

	DESTDIR="$pkgdir" cmake --install build --component depannage
	# Enabled: ends a session left open by a shutdown
	install -d "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../packarch-depannage-cleanup.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/packarch-depannage-cleanup.service
	install -Dm644 "$pkgbase-$pkgver"/README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}

package_packarch-admin() {
	pkgdesc="Remote help of Packarch computers (packarch-depannage): helper side"
	depends=('qt6-base' 'qtermwidget' 'tailscale' 'openssh' 'libnotify'
	         'gcc-libs' 'glibc')
	optdepends=('claude-code: "Dépanner avec Claude Code" (or Claude Code installed in ~/.local/bin)')

	DESTDIR="$pkgdir" cmake --install build --component admin
	install -Dm644 "$pkgbase-$pkgver"/README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}
