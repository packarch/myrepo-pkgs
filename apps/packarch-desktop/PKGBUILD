# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# packarch: the Wayland stacking compositor of the Packarch desktop (Rust,
# Smithay): windows decorated by the compositor with Openbox themes, rounded
# corners and shadows, Openbox menus (menu.xml, pipemenus) rounded and
# shadowed, rc.xml in the Openbox format, sober animations, XWayland, the
# protocols of waybar, hyprlock, swayidle, grim, wlr-randr, wlopm and the
# portals. Configuration of the Packarch desktop: packarch-desktop-settings.
#
# 1.0.0-1: first version
# 1.0.0-2: frame only when the client asks for it, cursor on the cursor plane
# 1.0.0-3: DRM planes of each output in the log
# 1.1.0-1: sharp X11 applications at fractional scales (xwaylandSharp),
#          quarter tiling (SnapToEdge combine="yes"), magnifier (ZoomIn,
#          ZoomOut, ToggleMagnify)
# 1.1.1-1: maximize button restores a window dragged to the top of the screen,
#          title bar always reachable when restored, magnifier border in
#          the highlight color of the theme
# 1.1.2-1: frame of the windows as the application asks (GtkHeaderBar
#          applications such as Packarch Hello keep only their own title bar)
# 1.1.3-1: a single cursor in virtual machines (cursor plane of virtio-gpu,
#          qxl and vmwgfx with its hotspot: patched Smithay in vendor/)
# 1.1.4-1: session opened from LightDM (waits for the libseat session to be
#          active before opening the GPU)
# 1.1.5-1: make, model and serial number of the monitors read from their
#          EDID; ~/.Xresources merged into XWayland; log without color codes
# 1.1.6-1: log without empty details (keyboard variant, app_id)
# 1.2.0-1: renamed from packarch-rwdesktop (repository packarch-desktop);
#          the only Wayland desktop of Packarch (labwc removed)
# 1.2.1-1: systemd session target (packarch-session.target): XDG autostart
#          entries run by systemd and stopped at the end of the session
# 1.3.0-1: explicit sync (linux-drm-syncobj-v1, NVIDIA 560+), variable refresh
#          rate (<core><adaptiveSync>: no, yes, fullscreen)
# 1.3.1-1: frame callbacks and presentation feedback paced by the primary
#          output of each surface, sent at vblank (smooth X11 video players
#          such as Nounours Player on two monitors)
# 1.3.2-1: windows with rounded corners no longer lag (their surfaces were
#          seen as hidden and got one frame callback per second)
# 1.3.3-1: smooth video in every player (a commit released by its sync point
#          now triggers a redraw; events flushed to clients every loop turn)
# 1.3.4-1: rounded windows no longer fully redrawn every frame (stable
#          element ids), submenus open on the screen of their parent menu
# 1.4.0-1: capture of a single window or output (ext-image-copy-capture:
#          window sharing with xdg-desktop-portal-wlr 0.8, grim -T),
#          screencopy into dmabuf buffers and only when the screen changes,
#          virtual pointer (wlr-virtual-pointer), panics logged with a
#          backtrace
# 1.4.1-1: screen sharing of a single window: packarch-partage lists the
#          outputs and windows in rofi for xdg-desktop-portal-wlr
#          (/etc/xdg/xdg-desktop-portal-wlr/packarch)
# 1.4.2-1: screen recording on NVIDIA: linear dmabuf of wf-recorder filled
#          by the CPU (not renderable by the GPU)
# 1.4.3-1: drag and drop icon (file or folder) drawn under the pointer
# 1.4.4-1: drag and drop between Wayland and X11 applications (XDND, both
#          directions: Thunar to FileBot and back)
# 1.4.5-1: drag and drop to Java applications (FileBot): the X client may
#          read the dragged data several times
# 1.4.6-1: usable without the rest of the Packarch desktop: default
#          configuration in /etc/xdg/packarch (rc.xml, menu.xml: applications
#          by category, windows, terminal, session), keyboard layout also from
#          /etc/default/keyboard, gray pacman in the middle of the background
#          (<core><logo>no</logo></core> removes it)
# 1.4.7-1: copy from a Wayland application to the X11 clients without a
#          focused window (spice-vdagent: copy from a virtual machine to the
#          host, X11 clipboard managers)
# 1.4.8-1: Ghostty first in the default terminals ($TERMINAL, then ghostty,
#          foot, kitty…)
# 1.4.9-1: default background of the bare compositor: the maze of the
#          Packarch theme, full screen (instead of the dark pacman)
# 1.4.10-1: scale of each window from the output its center is on (two
#          outputs with different scales), Kill on an X11 window ends its
#          process (not the whole XWayland), <libinput> applied again on
#          reconfigure, -s COMMAND run after the autostart script,
#          XDG_SESSION_TYPE removed from systemd at the end of the session
# 1.4.11-1: transparent X11 windows (ARGB visual: conky, transparent
#          terminals): they were opaque, black where transparent (32-bit
#          frame for a 32-bit window)
# 1.4.12-1: window rules dropShadow="no" and keepBorder="no": no shadow and
#          no border around an undecorated transparent window laid on the
#          background (conky)
# 1.4.13-1: keybinds repeat while the key is held (repeat="yes|no"; by
#           default volume, brightness, MoveRelative, ResizeRelative, zoom);
#           window menu and fullscreen output asked by the application;
#           wlr-gamma-control (gammastep, wlsunset)
# 1.4.14-1: styles of the desktop switch animation (<workspace-switch
#           style="slide|fade|zoom|pull-back">)
# 1.4.15-1: a window maximized before it is shown (Firefox reopened
#           maximized) takes the usable area of the output where it is placed
#           (its bottom went under the bottom bar with two outputs)

pkgname=packarch-desktop
pkgver=1.4.15
pkgrel=1
pkgdesc="Wayland stacking compositor of the Packarch desktop (packarch)"
arch=('x86_64')
url="https://github.com/packarch/packarch-desktop"
license=('MIT OR Apache-2.0')
depends=(
  'gcc-libs' 'glibc' 'libdrm' 'libglvnd' 'libinput' 'libxkbcommon' 'mesa'
  'seatd' 'systemd-libs' 'xorg-xwayland'
)
optdepends=(
  'dbus: separate D-Bus bus when another session of the user is running'
  'xdg-desktop-portal-wlr: screenshots and screen sharing (packarch-portals.conf)'
  'rofi: choice of the output or window to share (packarch-partage)'
  'xdg-desktop-portal-gtk: file chooser and other portals (packarch-portals.conf)'
  'hwdata: full manufacturer names of the monitors'
  'xorg-xrdb: X resources (~/.Xresources, Xft.dpi) of the X11 applications'
)
replaces=(packarch-rwdesktop)
conflicts=(packarch-rwdesktop)
provides=(packarch-rwdesktop)
backup=('etc/xdg/xdg-desktop-portal-wlr/packarch' 'etc/xdg/packarch/rc.xml'
        'etc/xdg/packarch/menu.xml')
makedepends=('cargo')
options=(!lto)
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "$pkgname-$pkgver"
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd "$pkgname-$pkgver"
	cargo build --frozen --release
}

check() {
	cd "$pkgname-$pkgver"
	cargo test --frozen --release
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 target/release/packarch "$pkgdir"/usr/bin/packarch
	install -Dm755 target/release/packarch-partage "$pkgdir"/usr/bin/packarch-partage
	install -Dm644 data/xdg-desktop-portal-wlr.conf "$pkgdir"/etc/xdg/xdg-desktop-portal-wlr/packarch
	install -Dm644 data/rc.xml "$pkgdir"/etc/xdg/packarch/rc.xml
	install -Dm644 data/menu.xml "$pkgdir"/etc/xdg/packarch/menu.xml
	install -Dm644 data/packarch.desktop "$pkgdir"/usr/share/wayland-sessions/packarch.desktop
	install -Dm644 data/packarch-session.target "$pkgdir"/usr/lib/systemd/user/packarch-session.target
	install -Dm644 data/packarch-portals.conf "$pkgdir"/usr/share/xdg-desktop-portal/packarch-portals.conf
	install -Dm644 docs/packarch.1 "$pkgdir"/usr/share/man/man1/packarch.1
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
	install -Dm644 docs/cahier-des-charges.md "$pkgdir"/usr/share/doc/$pkgname/cahier-des-charges.md
	install -Dm644 LICENSE-MIT "$pkgdir"/usr/share/licenses/$pkgname/LICENSE-MIT
	install -Dm644 LICENSE-APACHE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE-APACHE
}
