# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Theme (skin) chooser of the Packarch Openbox, XFCE and Packarch desktops:
# applies the themes described by the theme.toml files of
# packarch-openbox-settings (~/.config/openbox/themes) and their copies of
# packarch-xfce-settings (~/.config/xfce4/themes) and
# packarch-desktop-settings (~/.config/packarch/themes). "render" writes the default theme into the
# /etc/skel of these three packages when they are built (makedepends:
# build.sh builds packarch-skin first).
# Own repository since 1.1.0 (sources in myrepo-pkgs/packarch-skin/skin
# before, up to 1.0.0-19); 1.1.0: XFCE desktop; 1.1.1: "Couleur des
# dossiers" item kept last in the theme launcher of the XFCE panel; 1.2.0:
# "chooser" (theme window, yad) and "panel" (puts the theme button back on
# the XFCE panel), launcher files written by render; 1.3.0: Sway desktop
# (packarch-sway-settings); 1.3.1: a single theme chooser at a time; 1.3.2:
# rounded corners and shadows of SwayFX from the picom settings of the theme;
# 1.4.0: themes of the user in ~/.config/packarch-skin/themes (XFCE, Sway),
# replacing the ones of the system, "edit" command; colors of the terminal
# cursor and selection, Sway windows and lock screen, notification timeouts
# and shadow color read from theme.toml (optional keys) instead of fixed;
# 1.5.0: on every desktop the themes of the user are in
# ~/.config/<desktop>/themes (openbox, xfce4, sway), where the missing themes
# of the system are copied (a theme already there is never replaced);
# 1.6.0: labwc desktop (packarch-labwc-settings) instead of Sway: Openbox
# window theme, buttons, fonts, rounded corners and shadows in rc.xml and
# themerc-override, waybar, rofi, mako, kitty, hyprlock and GTK colors and
# themes; "openbox-menu" also on labwc; the Sway desktop is removed.
# 1.8.0: Packarch desktop (packarch compositor, packarch-rwdesktop-settings):
# the same files as labwc in ~/.config/packarch, reloaded by
# packarch --reconfigure
# 1.9.0: labwc desktop removed (Packarch only); thumbnails in
# /usr/share/packarch/desktop/icons (packarch-desktop-settings); scripts of
# the bars of ~/.config/labwc/ replaced by those of ~/.config/packarch/
# 1.10.0: default theme packarch (render, account without a current theme);
# the former default theme is named classic (an account that still has its
# theme "default" keeps it and does not get classic twice)
# 1.11.0: colors and font of the terminal Ghostty (~/.config/ghostty/colors
# and fonts, reloaded live by SIGUSR2), Openbox and Packarch desktops

pkgname=packarch-skin
pkgver=1.11.0
pkgrel=1
pkgdesc="Theme (skin) chooser of the Packarch Openbox, XFCE and Packarch desktops"
arch=('x86_64')
url="https://github.com/packarch/packarch-skin"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'packarch-folder-color')
makedepends=('cargo')
options=(!lto)
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "$pkgname-$pkgver"
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd "$pkgname-$pkgver"
	cargo build --frozen --release
}

check() {
	cd "$pkgname-$pkgver"
	cargo test --frozen --release
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 target/release/$pkgname "$pkgdir"/usr/bin/$pkgname
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}
