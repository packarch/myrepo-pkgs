# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Theme (skin) chooser of the Packarch Openbox, XFCE and Sway desktops: applies the
# themes described by the theme.toml files of packarch-openbox-settings
# (~/.config/openbox/themes) and, on XFCE, their copies in
# /usr/share/xfcethemes/themes (packarch-xfce-settings) and, on Sway,
# /usr/share/packarch/sway/themes (packarch-sway-settings). "render" writes the
# default theme into the /etc/skel of these three packages when they are built
# (makedepends: build.sh builds packarch-skin first).
# Own repository since 1.1.0 (sources in myrepo-pkgs/packarch-skin/skin
# before, up to 1.0.0-19); 1.1.0: XFCE desktop; 1.1.1: "Couleur des
# dossiers" item kept last in the theme launcher of the XFCE panel; 1.2.0:
# "chooser" (theme window, yad) and "panel" (puts the theme button back on
# the XFCE panel), launcher files written by render; 1.3.0: Sway desktop
# (packarch-sway-settings); 1.3.1: a single theme chooser at a time; 1.3.2:
# rounded corners and shadows of SwayFX from the picom settings of the theme;
# 1.4.0: themes of the user in ~/.config/packarch-skin/themes (XFCE, Sway),
# replacing the ones of the system, "edit" command; colors of the terminal
# cursor and selection, Sway windows and lock screen, notification timeouts
# and shadow color read from theme.toml (optional keys) instead of fixed;
# 1.5.0: on every desktop the themes of the user are in
# ~/.config/<desktop>/themes (openbox, xfce4, sway), where the missing themes
# of the system are copied (a theme already there is never replaced).

pkgname=packarch-skin
pkgver=1.5.0
pkgrel=1
pkgdesc="Theme (skin) chooser of the Packarch Openbox, XFCE and Sway desktops"
arch=('x86_64')
url="https://github.com/packarch/packarch-skin"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc' 'packarch-folder-color')
makedepends=('cargo')
options=(!lto)
source=("$pkgname-$pkgver.tar.gz::${url}/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

prepare() {
	cd "$pkgname-$pkgver"
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
	cd "$pkgname-$pkgver"
	cargo build --frozen --release
}

check() {
	cd "$pkgname-$pkgver"
	cargo test --frozen --release
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 target/release/$pkgname "$pkgdir"/usr/bin/$pkgname
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}
