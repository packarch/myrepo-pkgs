#!/usr/bin/env bash

## Packarch : actions « Définir comme fond d'écran » et « Définir comme écran
## de verrouillage » de Thunar (/usr/share/packarch/labwc/uca.xml) :
##   image --wallpaper FICHIER    fond d'écran de tous les écrans (wallpaper)
##   image --lockscreen FICHIER   fond de hyprlock (hyprlock.conf)
## Les fichiers modifiés sont ceux qu'écrit packarch-skin : changer de thème
## remet le fond d'écran et l'écran de verrouillage du thème.

dir="$HOME/.config/labwc"
notify() {
	notify-send -u "$1" -h string:x-canonical-private-synchronous:labwc-image "$2"
}

file="$2"
if [[ ! -f $file ]]; then
	notify critical "Image introuvable : $file"
	exit 1
fi
file="$(realpath -- "$file")"
# Retours à la ligne : impossibles dans les fichiers d'une ligne
if [[ $file == *$'\n'* ]]; then
	notify critical "Nom de fichier non pris en charge : $file"
	exit 1
fi

case "$1" in
	--wallpaper)
		printf '%s\n' "$file" > "$dir/wallpaper"
		"$dir/scripts/wallpaper"
		notify low "Fond d'écran : ${file##*/}"
		;;
	--lockscreen)
		# Pour sed : \, & et | du chemin protégés
		esc="$(printf '%s' "$file" | sed 's/[\\&|]/\\&/g')"
		sed -i "s|^\$wallpaper = .*|\$wallpaper = $esc|" "$dir/hyprlock.conf"
		notify low "Écran de verrouillage : ${file##*/}"
		;;
	*)
		echo "usage : image --wallpaper|--lockscreen FICHIER" >&2
		exit 2
		;;
esac
