#!/usr/bin/env bash

## Copyright (C) 2020-2026 Aditya Shakya <adi1090x@gmail.com>
##
## Waybar ---------------------------------------------------
##
## Packarch : barre du thème courant (~/.config/labwc/waybar/config, copiée
## de themes/ID/waybar par packarch-skin, comme polybar sous Openbox), sur
## l'écran principal seulement (ecran_principal de
## ~/.config/labwc/statusbar.conf ; « auto » ou écran absent : le premier
## écran actif). Configuration lancée : celle du thème avec "@output@"
## remplacé par cet écran et "@marge15@" par 15 % de sa largeur (barre
## flottante de spark), dans le dossier d'exécution. Les bureaux de labwc
## sont communs à tous les écrans. "@cpu-temp@" (module temperature) :
## capteur du processeur (k10temp, zenpower, coretemp...), cherché à chaque
## lancement car le numéro de hwmon change d'un démarrage à l'autre ; ligne
## retirée s'il n'y en a pas (waybar lit alors thermal_zone0).

CONFIG="$HOME/.config/labwc/waybar/config"
STYLE="$HOME/.config/labwc/waybar/style.css"

outputs="$(wlr-randr --json 2>/dev/null)"
wanted="$(sed -n 's/^[[:space:]]*ecran_principal[[:space:]]*=[[:space:]]*\([^[:space:]#]*\).*/\1/p' "$HOME/.config/labwc/statusbar.conf" 2>/dev/null | tail -1)"
output=""
if [[ -n $wanted && $wanted != auto ]] &&
	jq -e --arg o "$wanted" 'any(.[]; .name == $o and .enabled)' <<<"$outputs" >/dev/null 2>&1; then
	output="$wanted"
fi
[[ -n $output ]] || output="$(jq -r 'first(.[] | select(.enabled)) .name // empty' <<<"$outputs" 2>/dev/null)"

# Largeur logique de l'écran (mode courant, échelle, rotation)
width="$(jq -r --arg o "$output" 'first(.[] | select(.name == $o)) as $s
	| ($s.modes[] | select(.current)) as $m
	| (if ($s.transform // "normal" | test("90|270")) then $m.height else $m.width end) / ($s.scale // 1)
	| floor' <<<"$outputs" 2>/dev/null)"
[[ $width =~ ^[0-9]+$ ]] || width=1920
marge=$(( width * 15 / 100 ))

# Capteur de température du processeur, comme polybar/scripts/cpu-temp.sh
# d'Openbox : k10temp/zenpower (AMD), coretemp (Intel), cpu_thermal (ARM),
# Tctl, Tdie ou Package id 0 s'ils sont nommés, sinon une zone thermique
cpu_sensor() {
	local h l
	for h in /sys/class/hwmon/hwmon*; do
		case "$(cat "$h/name" 2>/dev/null)" in
			k10temp|zenpower|coretemp|cpu_thermal) ;;
			*) continue ;;
		esac
		for l in "$h"/temp*_label; do
			case "$(cat "$l" 2>/dev/null)" in
				Tctl|Tdie|"Package id 0") echo "${l%_label}_input"; return ;;
			esac
		done
		[[ -r $h/temp1_input ]] && { echo "$h/temp1_input"; return; }
	done
	for h in /sys/class/thermal/thermal_zone*; do
		case "$(cat "$h/type" 2>/dev/null)" in
			x86_pkg_temp|cpu-thermal|acpitz) echo "$h/temp"; return ;;
		esac
	done
}
cputemp="$(cpu_sensor)"
if [[ -n $cputemp ]]; then
	temp=(-e "s|\"@cpu-temp@\"|\"$cputemp\"|g")
else
	temp=(-e '/"@cpu-temp@"/d')
fi

run="${XDG_RUNTIME_DIR:-/tmp}/packarch-waybar"
mkdir -p "$run"
if [[ -n $output ]]; then
	sed "${temp[@]}" -e "s/\"@output@\"/\"${output//\//\\/}\"/g" -e "s/\"@marge15@\"/$marge/g" "$CONFIG" > "$run/config.jsonc"
else
	# Écran inconnu : barre sur tous les écrans
	sed "${temp[@]}" -e '/"@output@"/d' -e "s/\"@marge15@\"/$marge/g" "$CONFIG" > "$run/config.jsonc"
fi

# Pas de rétroéclairage (PC de bureau, écran externe) : module backlight
# retiré, avec le séparateur (point, tiret) qui le suit, ou qui le précède en
# fin de liste ; les flèches (thème adaptive, dégradés enchaînés) restent.
# Polybar le masquait de lui-même sous Openbox, waybar affiche « 0% ».
if ! compgen -G '/sys/class/backlight/*' >/dev/null; then
	nobl="$(sed '/^[[:space:]]*\/\//d' "$run/config.jsonc" | jq '
		def sep: type == "string" and test("^custom/(sep|dot)");
		def drop:
			. as $m
			| (index("backlight")) as $i
			| if $i == null then $m
			  elif ($i + 1 < ($m | length)) and ($m[$i + 1] | sep) then $m[:$i] + $m[$i + 2:]
			  elif $i > 0 and ($m[$i - 1] | sep) and ($i + 1 == ($m | length)) then $m[:$i - 1] + $m[$i + 1:]
			  else $m[:$i] + $m[$i + 1:] end;
		def fix: with_entries(if (.key | test("^modules-")) or (.value | type == "object" and has("modules"))
			then (if .key | test("^modules-") then .value |= drop else .value.modules |= drop end)
			else . end);
		if type == "array" then map(fix) else fix end' 2>/dev/null)" &&
		[[ -n $nobl ]] && printf '%s\n' "$nobl" > "$run/config.jsonc"
fi

# waybar lit le @import "./colors.css" de style.css depuis le dossier courant
cd "$(dirname "$STYLE")" || exit 1
exec waybar --log-level error --config "$run/config.jsonc" --style "${STYLE}"
