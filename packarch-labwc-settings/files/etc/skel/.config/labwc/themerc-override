# Réglages qui remplacent ceux du thème Openbox des fenêtres (voir
# `man 5 labwc-theme`). Les lignes entre les deux marques sont écrites par
# packarch-skin (ombres : réglages picom du thème) ; ajouter les vôtres en
# dehors.

# -- packarch-skin : début --
window.active.shadow.size: 20
window.active.shadow.color: #00000099
window.inactive.shadow.size: 20
window.inactive.shadow.color: #00000099
# -- packarch-skin : fin --

# Menus assez larges pour les libellés longs (« Gestionnaire de fichiers »,
# « Enregistrer une zone (sans le son) », lignes des infos système) : 200 px
# par défaut, tronqués
menu.width.max: 500
