<?xml version="1.0"?>
<!--
  Configuration de labwc (Packarch, packarch-labwc-settings). Voir
  `man 5 labwc-config` et `man 5 labwc-actions`.

  Le thème des fenêtres (thème Openbox OB-*), les boutons de la barre de
  titre, les polices, les coins arrondis et les ombres sont écrits par
  packarch-skin (thème courant : Super+Maj+t ou le bouton des thèmes de la
  barre) ; les tailles et couleurs des ombres dans themerc-override.
  Recharger après une modification : Ctrl+Maj+r.
-->
<labwc_config>

  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <xwaylandPersistence>no</xwaylandPersistence>
  </core>

  <placement>
    <policy>automatic</policy>
  </placement>

  <!-- Écrit par packarch-skin -->
  <theme>
    <name>OB-Packarch-Default</name>
    <icon>Qogir-Pink-Dark</icon>
    <titlebar>
      <layout>desk:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>6</cornerRadius>
    <keepBorder>yes</keepBorder>
    <dropShadows>yes</dropShadows>
    <dropShadowsOnTiled>no</dropShadowsOnTiled>
    <font place="ActiveWindow">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="InactiveWindow">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuHeader">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
    <font place="MenuItem">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>normal</weight>
      <slant>normal</slant>
    </font>
    <font place="OnScreenDisplay">
      <name>Noto Sans</name>
      <size>10</size>
      <weight>bold</weight>
      <slant>normal</slant>
    </font>
  </theme>

  <!-- Marges de l'écran laissées libres par les fenêtres (haut, bas, gauche,
       droite), écrites par packarch-skin ; waybar réserve déjà sa place -->
  <margin>
    <top>0</top>
    <bottom>0</bottom>
    <left>0</left>
    <right>0</right>
  </margin>

  <!-- Alt+Tab : liste des fenêtres -->
  <windowSwitcher preview="yes" outlines="yes" unshade="yes">
    <osd show="yes" style="classic" output="all" />
    <fields>
      <field content="icon" width="5%" />
      <field content="desktop_entry_name" width="30%" />
      <field content="title" width="65%" />
    </fields>
  </windowSwitcher>

  <!-- Bord de la zone utile (sous waybar) quasi infranchissable : une fenêtre
       glissée trop haut ne passe plus sous la barre, sa barre de titre
       reste attrapable. -->
  <resistance>
    <screenEdgeStrength>10000</screenEdgeStrength>
    <windowEdgeStrength>20</windowEdgeStrength>
  </resistance>

  <resize>
    <popupShow>Always</popupShow>
    <drawContents>yes</drawContents>
  </resize>

  <focus>
    <followMouse>no</followMouse>
    <raiseOnFocus>no</raiseOnFocus>
  </focus>

  <snapping>
    <range inner="10" outer="10" />
    <topMaximize>yes</topMaximize>
  </snapping>

  <!-- 4 bureaux, comme sous Openbox -->
  <desktops>
    <popupTime>500</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <!-- Zones du pavé numérique (Super+1…9 du pavé) -->
  <regions>
    <region name="bas-gauche"   x="0%"  y="50%" height="50%"  width="50%"  />
    <region name="bas"          x="0%"  y="50%" height="50%"  width="100%" />
    <region name="bas-droite"   x="50%" y="50%" height="50%"  width="50%"  />
    <region name="gauche"       x="0%"  y="0%"  height="100%" width="50%"  />
    <region name="centre"       x="10%" y="10%" height="80%"  width="80%"  />
    <region name="droite"       x="50%" y="0%"  height="100%" width="50%"  />
    <region name="haut-gauche"  x="0%"  y="0%"  height="50%"  width="50%"  />
    <region name="haut"         x="0%"  y="0%"  height="50%"  width="100%" />
    <region name="haut-droite"  x="50%" y="0%"  height="50%"  width="50%"  />
  </regions>

  <!--
    Raccourcis : ceux d'Openbox (fenêtres, bureaux, menus) et les applications
    et menus rofi de Packarch. Les chiffres des bureaux marchent sur un clavier
    français sans Maj (labwc compare d'abord les touches physiques).
  -->
  <keyboard>
    <numlock>on</numlock>
    <layoutScope>global</layoutScope>
    <repeatRate>25</repeatRate>
    <repeatDelay>600</repeatDelay>

    <!-- Menus de labwc -->
    <keybind key="W-space">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>
    <keybind key="A-space">
      <action name="ShowMenu" menu="client-menu" atCursor="no" />
    </keybind>
    <keybind key="A-S-space">
      <action name="ShowMenu" menu="client-list-combined-menu" />
    </keybind>

    <!-- Fenêtres suivante et précédente -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="W-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="W-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- Bureaux -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <keybind key="C-A-Right">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="C-A-Left">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-S-Right">
      <action name="SendToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="W-S-Left">
      <action name="SendToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-S-d">
      <action name="ToggleShowDesktop" />
    </keybind>

    <!-- labwc -->
    <keybind key="C-S-r">
      <action name="Reconfigure" />
      <action name="Execute" command="notify-send -u low -h string:x-canonical-private-synchronous:labwc 'Configuration rechargée'" />
    </keybind>
    <keybind key="C-A-Delete">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_powermenu'" />
    </keybind>

    <!-- Déplacer et redimensionner -->
    <keybind key="W-A-Up"><action name="MoveRelative" x="0" y="-20" /></keybind>
    <keybind key="W-A-Down"><action name="MoveRelative" x="0" y="20" /></keybind>
    <keybind key="W-A-Left"><action name="MoveRelative" x="-20" y="0" /></keybind>
    <keybind key="W-A-Right"><action name="MoveRelative" x="20" y="0" /></keybind>
    <keybind key="W-C-Right"><action name="ResizeRelative" right="20" /></keybind>
    <keybind key="W-C-Left"><action name="ResizeRelative" right="-20" /></keybind>
    <keybind key="W-C-Down"><action name="ResizeRelative" bottom="20" /></keybind>
    <keybind key="W-C-Up"><action name="ResizeRelative" bottom="-20" /></keybind>
    <keybind key="W-A-m"><action name="Move" /></keybind>
    <keybind key="W-A-r"><action name="Resize" /></keybind>
    <keybind key="W-A-c"><action name="AutoPlace" policy="center" /></keybind>

    <!-- Moitiés de l'écran, plein écran, centre -->
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" combine="yes" />
    </keybind>
    <keybind key="W-Up">
      <action name="Maximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="UnMaximize" />
      <action name="UnSnap" />
      <action name="AutoPlace" policy="center" />
    </keybind>
    <keybind key="W-a">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-KP_1"><action name="SnapToRegion" region="bas-gauche" /></keybind>
    <keybind key="W-KP_2"><action name="SnapToRegion" region="bas" /></keybind>
    <keybind key="W-KP_3"><action name="SnapToRegion" region="bas-droite" /></keybind>
    <keybind key="W-KP_4"><action name="SnapToRegion" region="gauche" /></keybind>
    <keybind key="W-KP_5"><action name="SnapToRegion" region="centre" /></keybind>
    <keybind key="W-KP_6"><action name="SnapToRegion" region="droite" /></keybind>
    <keybind key="W-KP_7"><action name="SnapToRegion" region="haut-gauche" /></keybind>
    <keybind key="W-KP_8"><action name="SnapToRegion" region="haut" /></keybind>
    <keybind key="W-KP_9"><action name="SnapToRegion" region="haut-droite" /></keybind>

    <!-- Fenêtre active -->
    <keybind key="W-c"><action name="Close" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-Escape"><action name="Kill" /></keybind>
    <keybind key="A-F5"><action name="Iconify" /></keybind>
    <keybind key="A-F6"><action name="ToggleMaximize" /></keybind>
    <keybind key="A-F7"><action name="ToggleShade" /></keybind>
    <keybind key="A-F8"><action name="ToggleDecorations" /></keybind>
    <keybind key="A-F9"><action name="ToggleOmnipresent" /></keybind>
    <keybind key="A-F10"><action name="ToggleFullscreen" /></keybind>
    <keybind key="A-F11"><action name="ToggleAlwaysOnTop" /></keybind>
    <keybind key="A-F12"><action name="ToggleAlwaysOnBottom" /></keybind>
    <keybind key="W-o"><action name="ToggleOmnipresent" /></keybind>
    <keybind key="W-y"><action name="ToggleDecorations" /></keybind>

    <!-- Terminal : kitty -->
    <keybind key="W-Return">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/kitty'" />
    </keybind>
    <keybind key="W-S-Return">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/kitty -f'" />
    </keybind>
    <keybind key="W-A-Return">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/kitty -F'" />
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/kitty'" />
    </keybind>
    <keybind key="C-A-v">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/kitty -f nano'" />
    </keybind>
    <keybind key="C-A-h">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/kitty -f htop'" />
    </keybind>

    <!-- Applications -->
    <keybind key="W-t"><action name="Execute" command="thunar" /></keybind>
    <keybind key="W-f"><action name="Execute" command="firefox" /></keybind>
    <keybind key="W-e"><action name="Execute" command="geany" /></keybind>
    <keybind key="W-S-e"><action name="Execute" command="geany" /></keybind>

    <!-- Menus rofi (un nouvel appui ferme le menu ouvert) -->
    <keybind key="A-F1">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_launcher'" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_launcher'" />
    </keybind>
    <keybind key="A-F2">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_runner'" />
    </keybind>
    <keybind key="W-r">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_asroot'" />
    </keybind>
    <keybind key="W-n">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_network'" />
    </keybind>
    <keybind key="W-x">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_powermenu'" />
    </keybind>
    <keybind key="W-s">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_screenshot'" />
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_bluetooth'" />
    </keybind>

    <!-- Thèmes Packarch, pipette -->
    <keybind key="W-S-t"><action name="Execute" command="packarch-skin chooser" /></keybind>
    <keybind key="W-p">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/colorpicker'" />
    </keybind>

    <!-- Verrouillage -->
    <keybind key="C-A-l">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/current_lock'" />
    </keybind>

    <!-- Captures d'écran -->
    <keybind key="Print">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --now'" />
    </keybind>
    <keybind key="A-Print">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --in5'" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --in10'" />
    </keybind>
    <keybind key="C-Print">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --win'" />
    </keybind>
    <keybind key="W-Print">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --area'" />
    </keybind>

    <!-- Touches de fonction -->
    <keybind key="XF86MonBrightnessUp" allowWhenLocked="yes">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/brightness --inc'" />
    </keybind>
    <keybind key="XF86MonBrightnessDown" allowWhenLocked="yes">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/brightness --dec'" />
    </keybind>
    <keybind key="XF86AudioRaiseVolume" allowWhenLocked="yes">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/volume --inc'" />
    </keybind>
    <keybind key="XF86AudioLowerVolume" allowWhenLocked="yes">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/volume --dec'" />
    </keybind>
    <keybind key="XF86AudioMute" allowWhenLocked="yes">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/volume --toggle'" />
    </keybind>
    <keybind key="XF86AudioMicMute" allowWhenLocked="yes">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/volume --toggle-mic'" />
    </keybind>
    <keybind key="XF86AudioNext"><action name="Execute" command="playerctl next" /></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute" command="playerctl previous" /></keybind>
    <keybind key="XF86AudioPlay"><action name="Execute" command="playerctl play-pause" /></keybind>
    <keybind key="XF86AudioStop"><action name="Execute" command="playerctl stop" /></keybind>
  </keyboard>

  <!--
    Souris : celle de labwc (comme Openbox). Un clic sur une fenêtre ou le
    bureau ferme aussi le menu rofi ouvert (rofi ne voit pas ces clics sous
    Wayland).
  -->
  <mouse>
    <doubleClickTime>500</doubleClickTime>

    <context name="Frame">
      <mousebind button="W-Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="W-Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="W-Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="W-Right" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>

    <context name="Border">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Left" action="Drag">
        <action name="Resize" />
      </mousebind>
    </context>

    <context name="TitleBar">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Execute" command="pkill -x rofi" />
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind direction="Up" action="Scroll">
        <action name="Unshade" />
        <action name="Focus" />
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="Unfocus" />
        <action name="Shade" />
      </mousebind>
    </context>

    <context name="Title">
      <mousebind button="Left" action="Drag">
        <action name="Move" />
      </mousebind>
      <mousebind button="Left" action="DoubleClick">
        <action name="ToggleMaximize" />
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ShowMenu" menu="client-menu" />
      </mousebind>
    </context>

    <context name="Maximize">
      <mousebind button="Left" action="Click">
        <action name="ToggleMaximize" />
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ToggleMaximize" direction="horizontal" />
      </mousebind>
      <mousebind button="Middle" action="Click">
        <action name="ToggleMaximize" direction="vertical" />
      </mousebind>
    </context>

    <context name="WindowMenu">
      <mousebind button="Left" action="Click">
        <action name="ShowMenu" menu="client-menu" atCursor="no" />
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ShowMenu" menu="client-menu" atCursor="no" />
      </mousebind>
    </context>

    <context name="Icon">
      <mousebind button="Left" action="Click">
        <action name="ShowMenu" menu="client-menu" atCursor="no" />
      </mousebind>
      <mousebind button="Right" action="Click">
        <action name="ShowMenu" menu="client-menu" atCursor="no" />
      </mousebind>
    </context>

    <context name="Shade">
      <mousebind button="Left" action="Click">
        <action name="ToggleShade" />
      </mousebind>
    </context>

    <context name="AllDesktops">
      <mousebind button="Left" action="Click">
        <action name="ToggleOmnipresent" />
      </mousebind>
    </context>

    <context name="Iconify">
      <mousebind button="Left" action="Click">
        <action name="Iconify" />
      </mousebind>
    </context>

    <context name="Close">
      <mousebind button="Left" action="Click">
        <action name="Close" />
      </mousebind>
    </context>

    <context name="Client">
      <mousebind button="Left" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Execute" command="pkill -x rofi" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="Focus" />
        <action name="Raise" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Focus" />
        <action name="Raise" />
        <action name="Execute" command="pkill -x rofi" />
      </mousebind>
    </context>

    <!-- Bureau : clic droit, menu de labwc ; clic milieu, liste des
         fenêtres ; molette, bureau suivant ou précédent -->
    <context name="Root">
      <mousebind button="Left" action="Press">
        <action name="Execute" command="pkill -x rofi" />
      </mousebind>
      <mousebind button="Right" action="Press">
        <action name="Execute" command="pkill -x rofi" />
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
      <mousebind button="Middle" action="Press">
        <action name="ShowMenu" menu="client-list-combined-menu" />
      </mousebind>
      <mousebind direction="Up" action="Scroll">
        <action name="GoToDesktop" to="left" wrap="yes" />
      </mousebind>
      <mousebind direction="Down" action="Scroll">
        <action name="GoToDesktop" to="right" wrap="yes" />
      </mousebind>
    </context>
  </mouse>

  <libinput>
    <device category="default">
      <tap>yes</tap>
      <naturalScroll>no</naturalScroll>
      <middleEmulation>yes</middleEmulation>
      <disableWhileTyping>yes</disableWhileTyping>
    </device>
  </libinput>

  <!-- Sélecteur de thèmes et de fond d'écran (waypaper) au centre de l'écran -->
  <windowRules>
    <windowRule identifier="yad" title="Thèmes Packarch">
      <action name="AutoPlace" policy="center" />
    </windowRule>
    <windowRule title="Waypaper">
      <action name="AutoPlace" policy="center" />
    </windowRule>
  </windowRules>

  <menu>
    <showIcons>yes</showIcons>
  </menu>

</labwc_config>
