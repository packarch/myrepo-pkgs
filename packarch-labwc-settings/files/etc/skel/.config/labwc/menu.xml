<?xml version="1.0" encoding="UTF-8"?>
<!--
  Menu du bureau labwc de Packarch (clic droit sur le bureau, Super+Espace),
  comme celui d'Openbox. Voir `man 5 labwc-menu`. Applications : menu généré
  par labwc-menu-generator ; styles : menu de packarch-skin.
-->
<openbox_menu>
  <menu id="root-menu" label="Packarch">
    <item label="Terminal" icon="utilities-terminal">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/kitty'" />
    </item>
    <item label="Gestionnaire de fichiers" icon="system-file-manager">
      <action name="Execute" command="thunar" />
    </item>
    <item label="Navigateur web" icon="web-browser">
      <action name="Execute" command="firefox" />
    </item>
    <item label="Éditeur de texte" icon="accessories-text-editor">
      <action name="Execute" command="geany" />
    </item>
    <separator />
    <menu id="applications" label="Applications" icon="applications-all" execute="labwc-menu-generator -p -I -t 'kitty -e'" />
    <!-- Comme sous Openbox (pipemenu pa-asroot) ; le menu rofi des
         applications en root reste au raccourci de rc.xml -->
    <menu id="asroot" label="Applications en root" icon="dialog-password">
      <item label="Terminal (kitty)" icon="utilities-terminal">
        <action name="Execute" command="sh -c '~/.config/labwc/scripts/asroot &quot;kitty --class kitty-float --directory /root&quot;'" />
      </item>
      <item label="Gestionnaire de fichiers (thunar)" icon="system-file-manager">
        <action name="Execute" command="sh -c '~/.config/labwc/scripts/asroot thunar'" />
      </item>
      <item label="Éditeur de texte (geany)" icon="accessories-text-editor">
        <action name="Execute" command="sh -c '~/.config/labwc/scripts/asroot geany'" />
      </item>
    </menu>
    <menu id="favoris" label="Favoris Internet" icon="bookmarks" execute="sh -c '~/.config/labwc/scripts/bookmarks'" />
    <menu id="captures" label="Capture d’écran" icon="applets-screenshooter">
      <item label="Capturer le bureau" icon="user-desktop">
        <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --now'" />
      </item>
      <item label="Capturer une zone" icon="edit-select">
        <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --area'" />
      </item>
      <item label="Capturer un écran" icon="video-display">
        <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --win'" />
      </item>
      <item label="Capturer dans 5 s" icon="chronometer">
        <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --in5'" />
      </item>
      <item label="Capturer dans 10 s" icon="chronometer">
        <action name="Execute" command="sh -c '~/.config/labwc/scripts/screenshot --in10'" />
      </item>
    </menu>
    <menu id="record" label="Enregistreur d’écran" icon="media-record" execute="sh -c '~/.config/labwc/scripts/record'" />
    <separator />
    <menu id="preferences" label="Préférences" icon="preferences-system">
      <item label="Thèmes Packarch" icon="preferences-desktop-theme">
        <action name="Execute" command="packarch-skin chooser" />
      </item>
      <menu id="styles" label="Changer de style" icon="preferences-desktop-theme-applications" execute="packarch-skin openbox-menu" />
      <item label="Couleur des dossiers" icon="preferences-desktop-color">
        <action name="Execute" command="packarch-folder-color" />
      </item>
      <item label="Changer de fond d’écran" icon="preferences-desktop-wallpaper">
        <action name="Execute" command="waypaper" />
      </item>
      <item label="Apparence (GTK)" icon="preferences-desktop-theme-global">
        <action name="Execute" command="nwg-look" />
      </item>
      <separator />
      <item label="Écrans" icon="preferences-desktop-display">
        <action name="Execute" command="wdisplays" />
      </item>
      <item label="Paramètres audio" icon="multimedia-volume-control">
        <action name="Execute" command="pavucontrol" />
      </item>
      <item label="Réseau" icon="preferences-system-network">
        <action name="Execute" command="nm-connection-editor" />
      </item>
      <separator />
      <menu id="labwc-config" label="labwc" icon="labwc">
        <item label="Modifier rc.xml" icon="document-edit">
          <action name="Execute" command="sh -c 'geany ~/.config/labwc/rc.xml'" />
        </item>
        <item label="Modifier menu.xml" icon="document-edit">
          <action name="Execute" command="sh -c 'geany ~/.config/labwc/menu.xml'" />
        </item>
        <item label="Modifier autostart" icon="document-edit">
          <action name="Execute" command="sh -c 'geany ~/.config/labwc/autostart'" />
        </item>
        <item label="Modifier environment" icon="document-edit">
          <action name="Execute" command="sh -c 'geany ~/.config/labwc/environment'" />
        </item>
        <item label="Modifier les favoris Internet" icon="document-edit">
          <action name="Execute" command="sh -c 'geany ~/.config/labwc/favoris.txt'" />
        </item>
        <separator />
        <item label="Recharger la configuration" icon="view-refresh">
          <action name="Reconfigure" />
        </item>
      </menu>
    </menu>
    <separator />
    <item label="Verrouiller l’écran" icon="system-lock-screen">
      <action name="Execute" command="sh -c '~/.config/labwc/scripts/current_lock'" />
    </item>
    <menu id="systeme" label="Système" icon="system-shutdown">
      <item label="Se déconnecter" icon="system-log-out">
        <action name="Exit" />
      </item>
      <item label="Mettre en veille" icon="system-suspend">
        <action name="Execute" command="systemctl suspend" />
      </item>
      <item label="Redémarrer" icon="system-reboot">
        <action name="Execute" command="systemctl reboot" />
      </item>
      <item label="Éteindre" icon="system-shutdown">
        <action name="Execute" command="systemctl poweroff" />
      </item>
    </menu>
  </menu>
</openbox_menu>
