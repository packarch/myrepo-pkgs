// Barre waybar du thème « yellow-flower » du bureau labwc de Packarch, comme
// sa barre polybar sous Openbox. Copiée dans ~/.config/labwc/waybar/config
// par packarch-skin, qui y remplace les @couleur@ par les couleurs du thème ;
// "@output@" (écran principal) et "@marge15@" : remplis par scripts/statusbar.
[
  {
    "name": "main",
    "output": "@output@",
    "layer": "top",
    "position": "top",
    "height": 30,
    "exclusive": true,
    "fixed-center": true,
    "spacing": 8,
    "reload_style_on_change": true,
    "ext/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "default": "",
        "active": ""
      },
      "on-click": "activate",
      "sort-by-id": true,
      "all-outputs": true
    },
    "custom/sep#s1": {
      "format": "|",
      "tooltip": false
    },
    "cpu": {
      "interval": 5,
      "format": "<span color='@yellow@'></span> {usage}%",
      "tooltip": false,
      "on-click": "kitty -e htop"
    },
    "memory": {
      "interval": 10,
      "format": "<span color='@blue@'></span> {used:0.1f}G",
      "tooltip-format": "Mémoire : {used:0.1f} Go / {total:0.1f} Go",
      "on-click": "kitty -e htop"
    },
    "disk": {
      "interval": 60,
      "paths": [
        "/"
      ],
      "format": "<span color='@magenta@'></span> {free}",
      "tooltip-format": "/ : {used} utilisés sur {total}"
    },
    "modules-left": [
      "ext/workspaces",
      "custom/sep#s1",
      "cpu",
      "memory",
      "disk"
    ],
    "clock": {
      "interval": 60,
      "locale": "fr_FR.UTF-8",
      "format": "<span color='@red@'></span> {:%d %b %H:%M}",
      "format-alt": "<span color='@red@'></span> {:%A %d %B %Y}",
      "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "modules-center": [
      "clock"
    ],
    "battery": {
      "interval": 60,
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "<span color='@yellow@'>{icon}</span> {capacity}%",
      "format-charging": "<span color='@red@'></span> {capacity}%",
      "format-plugged": "<span color='@red@'></span> {capacity}%",
      "format-full": "<span color='@red@'></span> Chargée",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "format-time": "{H}h{M:02}",
      "tooltip-format": "{timeTo}"
    },
    "bluetooth": {
      "format": "<span color='@blue@'></span> {status}",
      "format-on": "<span color='@blue@'></span> Activé",
      "format-off": "<span color='@foreground-alt@'>󰂲</span> Désactivé",
      "format-disabled": "<span color='@foreground-alt@'>󰂲</span> Désactivé",
      "format-connected": "<span color='@blue@'>󰂱</span> {device_alias}",
      "format-connected-battery": "<span color='@blue@'>󰂱</span> {device_alias} {device_battery_percentage}%",
      "format-no-controller": "",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_bluetooth",
      "on-click-right": "blueman-manager"
    },
    "network": {
      "interval": 5,
      "format-wifi": "<span color='@magenta@'>󰤨</span> {essid}",
      "format-ethernet": "<span color='@magenta@'>󰈀</span> {ifname}",
      "format-linked": "<span color='@magenta@'>󰈀</span> {ifname} (pas d'IP)",
      "format-disconnected": "<span color='@foreground-alt@'>󰤭</span> Hors ligne",
      "format-disabled": "<span color='@foreground-alt@'>󰤭</span> Désactivé",
      "tooltip-format": "{ifname} · {ipaddr}/{cidr} via {gwaddr}",
      "on-click": "~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_network",
      "on-click-right": "nm-connection-editor"
    },
    "custom/sep#s2": {
      "format": "|",
      "tooltip": false
    },
    "backlight": {
      "format": "{icon}",
      "format-icons": [
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'></span><span color='@foreground-alt@'>━━━━━━━━━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━</span><span color='@foreground-alt@'>━━━━━━━━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━</span><span color='@foreground-alt@'>━━━━━━━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━━</span><span color='@foreground-alt@'>━━━━━━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━━━</span><span color='@foreground-alt@'>━━━━━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━━━━</span><span color='@foreground-alt@'>━━━━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━━━━━</span><span color='@foreground-alt@'>━━━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━━━━━━</span><span color='@foreground-alt@'>━━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━━━━━━━</span><span color='@foreground-alt@'>━━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━━━━━━━━</span><span color='@foreground-alt@'>━</span>",
        "<span color='@yellow@'>󰃠</span> <span color='@yellow@'>━━━━━━━━━━</span><span color='@foreground-alt@'></span>"
      ],
      "tooltip-format": "Luminosité : {percent}%",
      "on-scroll-up": "light -A 5",
      "on-scroll-down": "light -U 5"
    },
    "tray": {
      "icon-size": 16,
      "spacing": 8
    },
    "modules-right": [
      "battery",
      "bluetooth",
      "network",
      "custom/sep#s2",
      "backlight",
      "tray"
    ]
  },
  {
    "name": "bottom",
    "output": "@output@",
    "layer": "top",
    "position": "bottom",
    "height": 30,
    "exclusive": true,
    "fixed-center": true,
    "spacing": 8,
    "reload_style_on_change": true,
    "custom/menu": {
      "format": "<span color='@accent@' font_family='packarch'></span>",
      "tooltip-format": "Applications (clic droit : lancer une commande)",
      "on-click": "~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_launcher",
      "on-click-right": "~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_runner"
    },
    "custom/sep#s3": {
      "format": "|",
      "tooltip": false
    },
    "custom/launch-firefox": {
      "tooltip-format": "Firefox (clic droit : Gmail)",
      "on-click": "firefox",
      "on-click-right": "firefox https://mail.google.com",
      "format": "<span color='@magenta@'></span>"
    },
    "custom/launch-thunar": {
      "tooltip-format": "Fichiers (clic droit : en administrateur)",
      "on-click": "thunar",
      "on-click-right": "~/.config/labwc/scripts/asroot thunar",
      "format": "<span color='@blue@'></span>"
    },
    "custom/launch-kitty": {
      "tooltip-format": "Terminal (clic droit : en administrateur)",
      "on-click": "~/.config/labwc/scripts/kitty",
      "on-click-right": "~/.config/labwc/scripts/asroot 'kitty --class kitty-float'",
      "format": "<span color='@green@'></span>"
    },
    "modules-left": [
      "custom/menu",
      "custom/sep#s3",
      "custom/launch-firefox",
      "custom/launch-thunar",
      "custom/launch-kitty"
    ],
    "wlr/taskbar": {
      "format": "{icon} {title:.25}",
      "icon-size": 16,
      "tooltip-format": "{title}",
      "on-click": "minimize-raise",
      "on-click-middle": "close",
      "on-click-right": "maximize",
      "all-outputs": true,
      "ignore-list": [
        "yad"
      ]
    },
    "modules-center": [
      "wlr/taskbar"
    ],
    "pulseaudio": {
      "format": "{icon}",
      "format-bluetooth": "{icon}",
      "format-muted": "<span color='@foreground-alt@'>󰝟</span> Muet",
      "format-icons": {
        "default": [
          "<span color='@blue@'>󰕾</span> <span color='@blue@'></span><span color='@foreground-alt@'>━━━━━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━</span><span color='@foreground-alt@'>━━━━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━</span><span color='@foreground-alt@'>━━━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━</span><span color='@foreground-alt@'>━━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━</span><span color='@foreground-alt@'>━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━</span><span color='@foreground-alt@'>━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━</span><span color='@foreground-alt@'>━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━━</span><span color='@foreground-alt@'>━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━━━</span><span color='@foreground-alt@'>━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━━━━</span><span color='@foreground-alt@'>━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━━━━━</span><span color='@foreground-alt@'></span>"
        ]
      },
      "scroll-step": 5.0,
      "tooltip-format": "Volume : {volume}% ({desc})",
      "on-click": "pulsemixer --toggle-mute",
      "on-click-right": "pavucontrol",
      "smooth-scrolling-threshold": 1
    },
    "custom/sep#s4": {
      "format": "|",
      "tooltip": false
    },
    "custom/power": {
      "format": "<span color='@red@'></span>",
      "tooltip-format": "Éteindre, redémarrer, se déconnecter…",
      "on-click": "~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_powermenu"
    },
    "modules-right": [
      "pulseaudio",
      "custom/sep#s4",
      "custom/power"
    ]
  }
]
