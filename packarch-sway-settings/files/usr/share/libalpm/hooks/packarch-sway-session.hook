# Packarch (packarch-sway-settings), d'après le hook d'Archcraft : la session
# Sway de LightDM lance packarch-run-sway (variables de Wayland, clavier du
# système) au lieu de sway

[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = packarch-sway-settings
Target = sway

[Action]
Description = Session Sway de Packarch (packarch-run-sway)...
When = PostTransaction
Exec = /usr/bin/sed -i -e 's|^Exec=.*|Exec=/usr/bin/packarch-run-sway|' /usr/share/wayland-sessions/sway.desktop
