##-- Style -------------------------------
## Les lignes « set » sont écrites par packarch-skin (thème courant)

default_border pixel 2
default_floating_border pixel 2
smart_borders off

titlebar_border_thickness 2
titlebar_padding 6 6
title_align center

## marges entre les fenêtres, remises par Super+clic molette (config)
set $gaps_inner 10
gaps inner $gaps_inner
gaps outer 0

##-- SwayFX : coins arrondis et ombres ---
## Valeurs écrites par packarch-skin : réglages picom du thème (comme sous
## Openbox). Commandes de SwayFX : la configuration ne marche plus avec Sway
## seul (les retirer pour revenir à Sway).
corner_radius 6
smart_corner_radius enable
shadows enable
shadows_on_csd disable
shadow_blur_radius 20
shadow_color #00000099

##-- Couleurs ----------------------------
set $sway_cl_col_bg #1E2128
set $sway_cl_col_fg #ABB2BF
set $sway_cl_col_in #98C379
set $sway_cl_col_afoc #5294E2
set $sway_cl_col_ifoc #62AEEF
set $sway_cl_col_ufoc #292d37
set $sway_cl_col_urgt #C778DD
set $sway_cl_col_phol #1E2128

# class                  border              backgr.             text              indicator         child_border
client.focused           $sway_cl_col_afoc   $sway_cl_col_afoc   $sway_cl_col_bg   $sway_cl_col_in   $sway_cl_col_afoc
client.focused_inactive  $sway_cl_col_ifoc   $sway_cl_col_ifoc   $sway_cl_col_bg   $sway_cl_col_in   $sway_cl_col_ifoc
client.unfocused         $sway_cl_col_ufoc   $sway_cl_col_ufoc   $sway_cl_col_fg   $sway_cl_col_in   $sway_cl_col_ufoc
client.urgent            $sway_cl_col_urgt   $sway_cl_col_urgt   $sway_cl_col_fg   $sway_cl_col_in   $sway_cl_col_urgt
client.placeholder       $sway_cl_col_phol   $sway_cl_col_phol   $sway_cl_col_fg   $sway_cl_col_in   $sway_cl_col_phol
client.background        $sway_cl_col_bg

##-- Thèmes GTK, icônes et curseur -------
set $sway_gtk_theme Packarch-Default
set $sway_icon_theme Qogir-Pink-Dark
set $sway_cursor_theme Pear-Dark
set $sway_color_scheme prefer-dark
set $sway_fonts Noto Sans 10

seat * xcursor_theme $sway_cursor_theme 24

set $gnome-schema org.gnome.desktop.interface

exec_always {
    gsettings set $gnome-schema gtk-theme    $sway_gtk_theme
    gsettings set $gnome-schema icon-theme   $sway_icon_theme
    gsettings set $gnome-schema cursor-theme $sway_cursor_theme
    gsettings set $gnome-schema cursor-size  24
    gsettings set $gnome-schema color-scheme $sway_color_scheme
}
# Nom de police avec des espaces : guillemets gardés pour le shell
exec_always "gsettings set $gnome-schema font-name '$sway_fonts'"
