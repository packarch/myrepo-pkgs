# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Sway configuration of Packarch: waybar, rofi menus, mako notifications,
# hyprlock, sov and kitty (the only terminal), with the 10 themes and
# wallpapers of the Openbox and XFCE desktops, applied by packarch-skin
# (Sway desktop since packarch-skin 1.3.0). Based on the GPL3 Sway
# configuration of Aditya Shakya (archcraft-sway-free,
# https://github.com/archcraft-os/archcraft-sway, 2026-08-08), not on the
# DBAD one of Archcraft Prime (redistribution forbidden). The configuration
# goes to /etc/skel/.config/sway, with the default theme already applied to
# it at build time (packarch-skin render).
#
# Our changes: French translation, kitty only (no alacritty, foot, wofi,
# wlogout), no Spotify/mpd modules and scripts (media keys use playerctl), no
# pywal/light mode theme.sh (packarch-skin: Super+t or the theme button of
# waybar opens "packarch-skin chooser"), 24-hour clock, wallpapers of
# packarch-backgrounds (/usr/share/backgrounds) instead of the Archcraft ones,
# no screen lock nor blanking on idle (only before suspend), numlock on,
# keyboard layout of the system (localectl, read by packarch-run-sway),
# workspaces bound to the key codes (AZERTY digits), XDG autostart with dex
# (cachy-update, xfce-polkit, GitHub setup; picom and plain nm-applet hidden
# under Sway by ~/.config/autostart), kitty of the whole session with the
# Sway configuration (KITTY_CONFIG_DIRECTORY), Sway default session of
# LightDM (60-packarch-sway.conf), kitty for Terminal=true applications
# (/etc/xdg/sway-xdg-terminals.list, xdg-terminal-exec).
#
# The themes are the theme.toml files of packarch-openbox-settings, copied to
# /usr/share/packarch/sway/themes, with the thumbnails of
# packarch-xfce-settings (/usr/share/packarch/sway/icons) for the chooser.
# No file in common with packarch-openbox-settings and packarch-xfce-settings:
# installable next to them.
#
# 1.0-2: icon of the theme button of waybar (custom/themes), empty in 1.0-1:
# waybar hid the button
# 1.0-3: waybar like the polybar of the Openbox "packarch" theme: application
# menu on the left, launchers in the center (Firefox, Thunar, kitty, and
# Discord, FileZilla, MKVToolNix, FileBot when installed), power button on
# the right; a single theme chooser at a time (flock)
# 1.0-4: no flock, packarch-skin 1.3.1 opens a single chooser itself (flock
# held its lock file, the chooser of 1.3.1 would then never open)

pkgname=packarch-sway-settings
pkgver=1.0
pkgrel=4
pkgdesc="Sway configuration of Packarch"
arch=('any')
url="https://github.com/packarch/myrepo-pkgs"
license=('GPL3')
depends=(
  # Sway and the tools of the configuration
  sway swaybg swayidle xorg-xwayland sov mako waybar rofi hyprlock hyprpicker
  grim slurp wl-clipboard jq imagemagick pulsemixer pavucontrol playerctl light
  libnotify dex xdg-terminal-exec xdg-user-dirs
  xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk
  network-manager-applet networkmanager-dmenu-git bluez-utils xfce-polkit
  # applications of the keys
  kitty thunar geany firefox viewnior htop nano yad
  # fonts of waybar, kitty, mako and hyprlock
  noto-fonts ttf-jetbrains-mono-nerd packarch-fonts
  # LightDM greeter, menu hooks, cachy-update
  packarch-system-settings
  # theme chooser, GTK themes, icons, cursors and wallpapers
  'packarch-skin>=1.3.1' 'packarch-themes>=2.0-8' 'packarch-icons>=2.0-9'
  'packarch-backgrounds>=2.0-6' packarch-folder-color packarch-cursors
)
# Writes the default theme into /etc/skel (render)
makedepends=('packarch-skin>=1.3.1')
optdepends=('blueman: Bluetooth manager (right click on the Bluetooth module)')
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
	# The themes of the Openbox desktop (theme.toml only: polybar and rofi
	# layouts are not used), with the thumbnails of the XFCE theme launcher
	local t id themes="$startdir"/../packarch-openbox-settings/files/etc/skel/.config/openbox/themes
	local icons="$startdir"/../packarch-xfce-settings/files/usr/share/xfcethemes/icons
	for t in "$themes"/*/theme.toml; do
		id="$(basename "$(dirname "$t")")"
		install -Dm644 "$t" "$pkgdir"/usr/share/packarch/sway/themes/"$id"/theme.toml
		if [[ -f "$icons/$id.png" ]]; then
			install -Dm644 "$icons/$id.png" "$pkgdir"/usr/share/packarch/sway/icons/"$id".png
		fi
	done
	install -Dm644 /dev/stdin "$pkgdir"/usr/share/licenses/"$pkgname"/NOTICE <<-EOF
		Sway configuration based on archcraft-sway-free by Aditya Shakya
		(adi1090x), GPL-3.0: https://github.com/archcraft-os/archcraft-sway
	EOF
	# The first session starts with the default theme
	packarch-skin render "$pkgdir" default
}
