# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Sway configuration of Packarch: waybar, rofi menus, mako notifications,
# hyprlock, sov and kitty (the only terminal), with the 10 themes and
# wallpapers of the Openbox and XFCE desktops, applied by packarch-skin
# (Sway desktop since packarch-skin 1.3.0). Based on the GPL3 Sway
# configuration of Aditya Shakya (archcraft-sway-free,
# https://github.com/archcraft-os/archcraft-sway, 2026-08-08), not on the
# DBAD one of Archcraft Prime (redistribution forbidden). The configuration
# goes to /etc/skel/.config/sway, with the default theme already applied to
# it at build time (packarch-skin render).
#
# Our changes: French translation, kitty only (no alacritty, foot, wofi,
# wlogout), no Spotify/mpd modules and scripts (media keys use playerctl), no
# pywal/light mode theme.sh (packarch-skin: Super+Shift+t or the theme button of
# waybar opens "packarch-skin chooser"), 24-hour clock, wallpapers of
# packarch-backgrounds (/usr/share/backgrounds) instead of the Archcraft ones,
# no screen lock nor blanking on idle (only before suspend), numlock on,
# keyboard layout of the system (localectl, read by packarch-run-sway),
# workspaces bound to the key codes (AZERTY digits), XDG autostart with dex
# (cachy-update, xfce-polkit, GitHub setup; picom and plain nm-applet hidden
# under Sway by ~/.config/autostart), kitty of the whole session with the
# Sway configuration (KITTY_CONFIG_DIRECTORY), Sway default session of
# LightDM (60-packarch-sway.conf), kitty for Terminal=true applications
# (/etc/xdg/sway-xdg-terminals.list, xdg-terminal-exec).
#
# The themes are the theme.toml files of packarch-openbox-settings, copied to
# /usr/share/packarch/sway/themes, with the thumbnails of
# packarch-xfce-settings (/usr/share/packarch/sway/icons) for the chooser.
# No file in common with packarch-openbox-settings and packarch-xfce-settings:
# installable next to them.
#
# 1.0-2: icon of the theme button of waybar (custom/themes), empty in 1.0-1:
# waybar hid the button
# 1.0-3: waybar like the polybar of the Openbox "packarch" theme: application
# menu on the left, launchers in the center (Firefox, Thunar, kitty, and
# Discord, FileZilla, MKVToolNix, FileBot when installed), power button on
# the right; a single theme chooser at a time (flock)
# 1.0-4: no flock, packarch-skin 1.3.1 opens a single chooser itself (flock
# held its lock file, the chooser of 1.3.1 would then never open)
# 1.0-5: kitty closes its windows without asking for confirmation
# (confirm_os_window_close 0)
# 1.0-6: root applications ("sudo thunar", right click on the Thunar and
# kitty launchers, rofi "as root" menu): root may use Xwayland
# (xhost +si:localuser:root at startup); asroot uses sudo without -E (with
# the HOME and XDG_RUNTIME_DIR of the user, Thunar crashed and root wrote
# files in the home of the user) and dbus-run-session
# 1.0-7: root applications with the current theme (Thunar was white):
# asroot writes a GTK settings.ini (sway-theme values) in the runtime
# directory of the user and gives it to root by XDG_CONFIG_DIRS, with the icon
# themes of the user (XDG_DATA_DIRS) and their kitty configuration
# 1.0-8: kitty.conf includes colors.conf and fonts.conf by relative paths (root
# kitty was black: ~ is /root); root kitty (Xwayland) floating
# 1.0-9: workspace switcher like the polybar of the Openbox "packarch" theme:
# 4 workspaces always shown (persistent-workspaces), one ghost each, red when
# focused, cyan with windows, gray when empty
# 1.0-10: rofi menus (applications, power, screenshots...) accept an item on a
# single click (me-accept-entry MousePrimary, double click by default), like
# the rofi configuration of Openbox
# 1.0-11: SwayFX (cachyos repository, provides sway) instead of Sway: rounded
# corners and shadows of the windows, from the picom settings of the theme
# (packarch-skin 1.3.2); session hook also run for swayfx
# 1.0-12: Thunar actions in French (/usr/share/packarch/sway/uca.xml, copied
# by the startup script when ~/.config/Thunar/uca.xml is missing or only the
# example of Thunar, whose "Open Terminal Here" failed: no terminal for
# exo-open): "Ouvrir un terminal ici" (kitty) and "Thunar root"; asroot
# also takes separate arguments (paths with spaces)
# 1.0-13: no idle inhibitor in waybar (no screen lock nor blanking on idle:
# nothing to inhibit)
# 1.0-14: rofi menus closed by a click outside them (rofi has no click-to-exit
# under Wayland): scripts/menu puts Sway in the "Menu" mode (sway-modes) while
# a menu is open, where a click on a window or the desktop kills rofi; a menu
# already open is closed instead of starting a second one
# 1.0-15: waybar on the main output only, like polybar on Openbox: "set
# $ecran_principal" of sway-output ("auto", or an absent output: the output
# focused when the session starts); scripts/statusbar adds "output" to the
# waybar configuration (file in the runtime directory)
# 1.0-16: Super+t opens Thunar and Super+f Firefox (instead of Super+Shift+f
# and Super+Shift+w), the theme chooser moves to Super+Shift+t and the tabbed
# layout to Super+Shift+a; Super+space cycles the focused window between
# tiled, floating and fullscreen (scripts/window_cycle), instead of the
# separate floating (Super+space) and fullscreen (Super+f) toggles;
# Super+mouse wheel changes the gaps between the windows of the workspace
# (gaps inner current, like bspwm and sxhkd), Super+middle click restores
# them ($gaps_inner of sway-theme); the Thunar custom actions of Openbox
# (terminal here, search, open and edit as root, compare, wallpaper and lock
# screen image: scripts/image), also replacing the actions of the previous
# versions while nobody changed them; root Thunar (asroot) gets its own
# French actions (uca-root.xml: its "Open Terminal Here" example was in
# English and failed); the "Delete" action of Thunar is shown, for the user
# and for root, unless set otherwise (thunar-defaults)
# 1.0-19: Geany color schemes of the themes (packarch-geany-config): Geany
# ignored the scheme set by packarch-skin in a home without them

pkgname=packarch-sway-settings
pkgver=1.0
pkgrel=19
pkgdesc="Sway (SwayFX) configuration of Packarch"
arch=('any')
url="https://github.com/packarch/myrepo-pkgs"
license=('GPL3')
depends=(
  # Sway and the tools of the configuration
  swayfx swaybg swayidle xorg-xwayland sov mako waybar rofi hyprlock hyprpicker
  grim slurp wl-clipboard jq imagemagick pulsemixer pavucontrol playerctl light
  libnotify dex xdg-terminal-exec xdg-user-dirs xorg-xhost
  xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk
  network-manager-applet networkmanager-dmenu-git bluez-utils xfce-polkit
  # applications of the keys
  kitty thunar geany firefox viewnior htop nano yad
  # Geany color schemes of the themes
  packarch-geany-config
  # applications of the Thunar actions
  catfish meld xfconf
  # fonts of waybar, kitty, mako and hyprlock
  noto-fonts ttf-jetbrains-mono-nerd packarch-fonts
  # LightDM greeter, menu hooks, cachy-update
  packarch-system-settings
  # theme chooser, GTK themes, icons, cursors and wallpapers
  'packarch-skin>=1.3.2' 'packarch-themes>=2.0-8' 'packarch-icons>=2.0-9'
  'packarch-backgrounds>=2.0-6' packarch-folder-color packarch-cursors
)
# Writes the default theme into /etc/skel (render)
makedepends=('packarch-skin>=1.3.2')
optdepends=('blueman: Bluetooth manager (right click on the Bluetooth module)')
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
	# The themes of the Openbox desktop (theme.toml only: polybar and rofi
	# layouts are not used), with the thumbnails of the XFCE theme launcher
	local t id themes="$startdir"/../packarch-openbox-settings/files/etc/skel/.config/openbox/themes
	local icons="$startdir"/../packarch-xfce-settings/files/usr/share/xfcethemes/icons
	for t in "$themes"/*/theme.toml; do
		id="$(basename "$(dirname "$t")")"
		install -Dm644 "$t" "$pkgdir"/usr/share/packarch/sway/themes/"$id"/theme.toml
		if [[ -f "$icons/$id.png" ]]; then
			install -Dm644 "$icons/$id.png" "$pkgdir"/usr/share/packarch/sway/icons/"$id".png
		fi
	done
	install -Dm644 /dev/stdin "$pkgdir"/usr/share/licenses/"$pkgname"/NOTICE <<-EOF
		Sway configuration based on archcraft-sway-free by Aditya Shakya
		(adi1090x), GPL-3.0: https://github.com/archcraft-os/archcraft-sway
	EOF
	# The first session starts with the default theme
	packarch-skin render "$pkgdir" default
}
