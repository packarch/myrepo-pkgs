#!/usr/bin/env bash
# Packarch in /etc/os-release and /etc/lsb-release, after cachyos-branding
# (cachyos-hooks), which writes CachyOS there. ID_LIKE keeps cachyos before
# arch: fastfetch then shows the logo of CachyOS. /etc/issue shows
# PRETTY_NAME.

update_os_release() {
    local os_release="/etc/os-release"
    [[ -e $os_release ]] || return 0
    sed -i "$os_release" \
        -e 's|^NAME=.*$|NAME="Packarch"|' \
        -e 's|^PRETTY_NAME=.*$|PRETTY_NAME="Packarch"|' \
        -e 's|^ID=.*$|ID=packarch|' \
        -e 's|^ID_LIKE=.*$|ID_LIKE="cachyos arch"|' \
        -e 's|^HOME_URL=.*$|HOME_URL="https://github.com/packarch/Packarch"|' \
        -e 's|^SUPPORT_URL=.*$|SUPPORT_URL="https://github.com/packarch/Packarch/issues"|' \
        -e 's|^BUG_REPORT_URL=.*$|BUG_REPORT_URL="https://github.com/packarch/Packarch/issues"|' \
        -e 's|^LOGO=.*$|LOGO=org.packarch.hello|'
}

update_lsb_release() {
    local lsb_release="/etc/lsb-release"
    [[ -e $lsb_release ]] || return 0
    sed -i "$lsb_release" \
        -e 's|^DISTRIB_ID=.*$|DISTRIB_ID=packarch|' \
        -e 's|^DISTRIB_DESCRIPTION=.*$|DISTRIB_DESCRIPTION="Packarch"|'
}

# limine-entry-tool and limine-snapper-sync find the OS entry of limine.conf
# by the PRETTY_NAME of os-release when its machine-id comment is not under
# it (installations by Calamares before Packarch): the entry /+CachyOS is
# renamed, otherwise the next kernel update would add a second entry
# /+Packarch. limine.conf is enrolled again if enrollment is enabled (boot
# fails otherwise).
rename_limine_entry() {
    local esp conf
    [[ -r /etc/default/limine ]] || return 0
    esp=$(sed -n 's/^ESP_PATH="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/default/limine)
    conf="${esp:-/boot}/limine.conf"
    [[ -f $conf ]] && grep -qx '/+CachyOS' "$conf" || return 0
    sed -i 's|^/+CachyOS$|/+Packarch|' "$conf"
    if grep -qs '^ENABLE_ENROLL_LIMINE_CONFIG=yes' /etc/limine-entry-tool.conf /etc/default/limine &&
        command -v limine-enroll-config >/dev/null; then
        limine-enroll-config
    fi
}

# Limine theme of Packarch: the wallpaper written by Calamares
# (limine-splash.png on the ESP, from cachyos-wallpapers before Packarch) is
# replaced by the one of this package, and the comment of the theme names
# Packarch. The wallpaper has no checksum in limine.conf: no new enrollment.
update_limine_wallpaper() {
    local esp conf splash="/usr/share/packarch/limine-splash.png"
    [[ -r /etc/default/limine && -f $splash ]] || return 0
    esp=$(sed -n 's/^ESP_PATH="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/default/limine)
    esp="${esp:-/boot}"
    conf="$esp/limine.conf"
    [[ -f $conf ]] && grep -qx 'wallpaper: boot():/limine-splash.png' "$conf" || return 0
    cmp -s "$splash" "$esp/limine-splash.png" || cp -f "$splash" "$esp/limine-splash.png"
    sed -i 's|^# CachyOS Limine theme$|# Packarch Limine theme (wallpaper of Packarch)|' "$conf"
}

# Installation snapshot of Calamares (btrfs-installation-snapshot), named
# "Fresh CachyOS Installation" before Packarch: renamed in snapper and in the
# entry of limine.conf (enrolled again if enrollment is enabled).
rename_installation_snapshot() {
    local id
    command -v snapper >/dev/null && [[ -f /etc/snapper/configs/root ]] || return 0
    id=$(snapper --no-dbus -c root --csvout list --columns number,description 2>/dev/null |
        awk -F, '$2 == "Fresh CachyOS Installation" { print $1 }')
    for n in $id; do
        snapper --no-dbus -c root modify --description "Installation de Packarch" "$n"
    done
    # limine-snapper-sync keeps the text of the entries it already wrote
    local esp conf
    [[ -r /etc/default/limine ]] || return 0
    esp=$(sed -n 's/^ESP_PATH="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/default/limine)
    conf="${esp:-/boot}/limine.conf"
    [[ -f $conf ]] && grep -q '^ *comment: Fresh CachyOS Installation$' "$conf" || return 0
    sed -i 's|^\( *comment: \)Fresh CachyOS Installation$|\1Installation de Packarch|' "$conf"
    if grep -qs '^ENABLE_ENROLL_LIMINE_CONFIG=yes' /etc/limine-entry-tool.conf /etc/default/limine &&
        command -v limine-enroll-config >/dev/null; then
        limine-enroll-config
    fi
}

# GRUB theme packarch (this package) instead of the cachyos one, which
# Calamares wrote in /etc/default/grub before Packarch: the background of
# the cachyos theme shows CachyOS. grub.cfg is generated again if it exists.
update_grub_theme() {
    local conf="/etc/default/grub"
    local theme="/usr/share/grub/themes/packarch/theme.txt"
    [[ -f $conf && -f $theme ]] || return 0
    grep -q '^GRUB_THEME="\{0,1\}/usr/share/grub/themes/cachyos/theme.txt"\{0,1\}$' "$conf" || return 0
    sed -i "s|^GRUB_THEME=.*$|GRUB_THEME=\"$theme\"|" "$conf"
    if [[ -f /boot/grub/grub.cfg ]] && command -v grub-mkconfig >/dev/null; then
        grub-mkconfig -o /boot/grub/grub.cfg
    fi
}

update_os_release
update_lsb_release
rename_limine_entry
update_limine_wallpaper
rename_installation_snapshot
update_grub_theme
