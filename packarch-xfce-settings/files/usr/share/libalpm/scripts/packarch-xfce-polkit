#!/bin/sh
# xfce-polkit out of the XFCE session while xfce4-session starts polkit-gnome
# there, back in it otherwise (90-packarch-xfce-polkit.hook)

f=/etc/xdg/autostart/xfce-polkit.desktop
own=/etc/xdg/autostart/xfce-polkit-gnome-authentication-agent-1.desktop
agent=/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# xfce-polkit not installed: nothing to do
[ -f "$f" ] || exit 0

if [ -f "$own" ] && [ -x "$agent" ]; then
	# XFCE has its own agent
	if grep -q '^NotShowIn=' "$f"; then
		grep -q '^NotShowIn=.*XFCE;' "$f" ||
			sed -i '/^NotShowIn=/{s/;*$/;/;s/$/XFCE;/}' "$f"
	else
		echo 'NotShowIn=XFCE;' >>"$f"
	fi
else
	# No other agent under XFCE: xfce-polkit is the one
	sed -i '/^NotShowIn=/s/XFCE;//' "$f"
fi
exit 0
