<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
    <icon>Terminal</icon>
    <name>Ouvrir un terminal ici</name>
    <unique-id>1367866030392833-1</unique-id>
    <command>exo-open --working-directory %f --launch TerminalEmulator</command>
    <description>Ouvrir un terminal dans ce dossier</description>
    <patterns>*</patterns>
    <directories/>
</action>
<action>
    <icon>folder-red</icon>
    <name>Thunar root</name>
    <unique-id>1367866030392883-2</unique-id>
    <command>sudo thunar %f</command>
    <description>Ouvrir ce dossier dans Thunar en administrateur (root)</description>
    <patterns>*</patterns>
    <directories/>
</action>
<action>
    <icon>gksu-root-terminal</icon>
    <name>Terminal root</name>
    <unique-id>1598703540615476-2</unique-id>
    <command>sudo xfce4-terminal --default-working-directory=%f</command>
    <description>Ouvrir un terminal administrateur (root) dans ce dossier</description>
    <patterns>*</patterns>
    <directories/>
</action>
<action>
    <icon>system-search</icon>
    <name>Rechercher</name>
    <unique-id>1367866030392913-3</unique-id>
    <command>catfish %f</command>
    <description>Rechercher des fichiers et des dossiers</description>
    <patterns>*</patterns>
    <directories/>
</action>
<action>
    <icon>emblem-symbolic-link</icon>
    <name>Créer un lien symbolique</name>
    <unique-id>1598703611380362-3</unique-id>
    <command>ln -s %f %n&quot; (lien)&quot;</command>
    <description>Créer un lien symbolique vers cet élément</description>
    <patterns>*</patterns>
    <directories/>
    <other-files/>
</action>
<action>
    <icon>meld</icon>
    <name>Comparer</name>
    <unique-id>1598703765333830-5</unique-id>
    <command>meld %F</command>
    <description>Comparer des fichiers ou des dossiers avec Meld</description>
    <patterns>*</patterns>
    <directories/>
    <text-files/>
</action>
<action>
    <icon>application-x-archive</icon>
    <name>Extraire ici</name>
    <unique-id>1598703918895347-6</unique-id>
    <command>xarchiver -e %N</command>
    <description>Extraire l’archive dans ce dossier</description>
    <patterns>*</patterns>
    <other-files/>
</action>
<action>
    <icon>folder-cd</icon>
    <name>Monter l’image ISO</name>
    <unique-id>1598704203521603-7</unique-id>
    <command>pkexec mount -o loop -t iso9660 %f /mnt</command>
    <description>Monter l’image ISO dans /mnt</description>
    <patterns>*iso</patterns>
    <other-files/>
</action>
</actions>
