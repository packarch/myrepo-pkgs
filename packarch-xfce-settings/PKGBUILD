# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# XFCE configuration of Packarch: cachyos-xfce-settings 1.0.9
# (https://github.com/CachyOS/cachyos-xfce-settings) with the changes that
# the ISO used to make with a pacman hook, and the theme switcher
# (/usr/share/xfcethemes). Everything goes to /etc/skel (copied to the home of
# new users), except the theme switcher and the GSettings defaults.
#
# Our changes:
# - "default" theme of packarch-skin from the start (render, see "themes"
#   below): terminal colors in terminalrc (imported into xfconf by
#   xfce4-terminal at first start), same values in the GTK 2/3/4 files,
#   .icons/default and the GSettings override
# - theme switcher: panel launcher plugin-30 (launcher-30/),
#   ~/.config/xfcethemes (.current_theme), .xprofile (init-backdrop.sh)
# - no screen blanking, sleep or locking (xfce4-power-manager,
#   xfce4-screensaver, xfce4-session)
# - Firefox instead of Cachy Browser (panel launcher, helpers.rc, .profile,
#   whisker menu), Geany instead of mousepad (mimeapps.list), LilouCalc
#   instead of galculator (whisker menu, calculator key); no Parole and
#   epdfview in the whisker menu favorites
# - numeric keypad on (keyboards.xml)
# - Thunar: sudo instead of pkexec in the custom actions ("Terminal root"),
#   no "Set as desktop background" action, menu bar hidden, "Delete" in the
#   context menu, no automount (thunar-volman.xml); org.xfce.thunar icon for
#   the panel launcher
# - font DPI fixed to 96 (xsettings.xml /Xft/DPI, 1.0.9-2): xfsettingsd
#   computes it from the screen otherwise, ~70 with NVIDIA ("UseEdidDpi")
# - removed: qt5ct and Kvantum settings, Octopi notifier autostart (none of
#   them installed), and the dependencies only they or the CachyOS theme used
# - Packarch icon (packarch.png of packarch-system-settings) on the button of
#   the whisker menu instead of the CachyOS one (1.0.9-4)
# - htop instead of btop in the system monitor launcher of the panel (1.0.9-5)
#
# - themes (1.0.9-7): the theme switcher of colors is replaced by
#   packarch-skin, with the same themes as the Openbox desktop (names, GTK,
#   xfwm4, icon and cursor themes, folder colors, wallpapers, terminal and
#   Geany colors): the theme.toml files of packarch-openbox-settings are
#   copied to /usr/share/xfcethemes/themes when the package is built, and
#   "packarch-skin render" writes the default theme into /etc/skel. Panel
#   launcher plugin-30: one item per theme (packarch-skin apply THEME), with
#   a thumbnail of its wallpaper (icons/<theme>.png). theme-switcher.sh only
#   maps the former colors to the nearest theme (launchers of existing
#   users); init-backdrop.sh applies that theme once instead of a former color
# - "Couleur des dossiers" (1.0.9-8): last item of the theme launcher, at the
#   top of its menu (panel at the bottom), runs packarch-folder-color; the
#   launcher does not move the clicked item first any more (move-first false):
#   packarch-skin 1.1.1 puts the current theme first and keeps this item last
# - theme button that can be restored (1.0.9-9, packarch-skin 1.2.0): its
#   launcher files (launcher-30/) and items are written by "packarch-skin
#   render" from the themes (not in files/ any more); menu entries (whisker
#   menu, settings manager) "Thèmes Packarch" (packarch-skin chooser: window
#   with the themes, yad) and "Restaurer le bouton des thèmes" (packarch-skin
#   panel: puts the button back before the window list, or updates it)
# - no icons on the desktop (1.0.9-10, xfce4-desktop.xml /desktop-icons/style 0):
#   /etc/skel, so new users only (live session and new installations)
# - Qogir-Pink-Dark icons in the default theme (1.0.9-11, theme.toml of
#   packarch-openbox-settings, written into /etc/skel by the render below)
#
# Conflicts with packarch-openbox-settings (formerly packarch-openbox): both
# ship some files of /etc/skel (GTK, Thunar, xfconf), the ISO installs one
# desktop or the other.

pkgname=packarch-xfce-settings
pkgver=1.0.9
pkgrel=11
pkgdesc="XFCE configuration of Packarch"
arch=('any')
url="https://github.com/packarch/myrepo-pkgs"
license=('GPL-1.0-only')
depends=(
  xfce4-panel xfce4-whiskermenu-plugin xfdesktop xfconf thunar xfwm4 libnotify xorg-xrandr yad
  noto-fonts packarch-system-settings htop
  # themes of packarch-skin (1.0.9-7): the same as the Openbox desktop, with
  # the same packages
  'packarch-skin>=1.2.0' 'packarch-themes>=2.0-8' 'packarch-icons>=2.0-9'
  'packarch-backgrounds>=2.0-6' packarch-folder-color packarch-cursors
)
# Writes the default theme into /etc/skel (render)
makedepends=('packarch-skin>=1.2.0')
optdepends=(
  'firefox: web browser of the panel and the whisker menu'
  'geany: default text editor'
  'liloucalc: calculator of the whisker menu and the calculator key'
  'xfce4-terminal: terminal with the colors of the theme'
)
conflicts=(cachyos-xfce-settings packarch-openbox-settings packarch-openbox)
replaces=(cachyos-xfce-settings)
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
	# The themes of the Openbox desktop (theme.toml only: polybar and rofi
	# are not used)
	local t themes="$startdir"/../packarch-openbox-settings/files/etc/skel/.config/openbox/themes
	for t in "$themes"/*/theme.toml; do
		install -Dm644 "$t" "$pkgdir"/usr/share/xfcethemes/themes/"$(basename "$(dirname "$t")")"/theme.toml
	done
	# The first session starts with the default theme
	packarch-skin render "$pkgdir" default
}
