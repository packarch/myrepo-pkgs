# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# What no Packarch theme uses, installed by nothing (not on the ISO):
# sudo pacman -S packarch-extra
# - icon themes: Arc-Circle, Luna-Light, Nordic-Folders(-Bluish, -Green),
#   Numix-Apps(-White), Vimix-White(-Dark), White-Folders, Win11(-Dark), and
#   since 2.0-4 Vimix-Black(-Dark) (from packarch-icons). They inherit from
#   and link to the themes of packarch-icons (Packarch-Base,
#   Packarch-Base-Dark).
# - GTK themes (2.0-4, from packarch-themes): Arc-Dark, Dracula,
#   Greybird-dark, Gruvbox, Juno-Mirage, Nordic, Orchis-Red-Dark (themes of
#   the former XFCE color switcher)
# - wallpapers (2.0-4, from packarch-backgrounds and
#   packarch-backgrounds-openbox): those of the former XFCE color switcher,
#   xfce-default.png, those of the former Openbox themes
# 2.0-4: formerly packarch-icons-extra (renamed, replaced).
# 2.0-3: Luna-Light has its own copies of the icons it linked from Luna
# (removed from packarch-icons 2.0-8).
# 2.0-2: no broken symlinks (relinked to the same icon elsewhere in the
# theme, or removed so that the inherited theme provides it).
# Files: files/ (installed as is). Most of the content was collected or made
# by Aditya Shakya (adi1090x), GPL3.

pkgname=packarch-extra
pkgver=2.0
pkgrel=4
pkgdesc="Extra icon themes, GTK themes and wallpapers for Packarch (used by no Packarch theme)"
arch=('any')
url="https://github.com/packarch/myrepo-pkgs"
license=('GPL3')
depends=('packarch-icons>=2.0-9')
provides=(packarch-icons-extra)
conflicts=(packarch-icons-extra 'packarch-themes<2.0-7' 'packarch-backgrounds<2.0-6' packarch-backgrounds-openbox)
replaces=(packarch-icons-extra)
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
}
