// Barre waybar du thème « spark » du bureau labwc de Packarch, comme
// sa barre polybar sous Openbox. Copiée dans ~/.config/labwc/waybar/config
// par packarch-skin, qui y remplace les @couleur@ par les couleurs du thème ;
// "@output@" (écran principal) et "@marge15@" : remplis par scripts/statusbar.
[
  {
    "name": "main",
    "output": "@output@",
    "layer": "top",
    "position": "bottom",
    "height": 38,
    "exclusive": true,
    "fixed-center": true,
    "spacing": 0,
    "reload_style_on_change": true,
    "margin-bottom": 15,
    "margin-left": "@marge15@",
    "margin-right": "@marge15@",
    "ext/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "default": "",
        "active": ""
      },
      "on-click": "activate",
      "sort-by-id": true,
      "all-outputs": true
    },
    "modules-left": [
      "ext/workspaces"
    ],
    "wlr/taskbar": {
      "format": "{icon} {title:.25}",
      "icon-size": 16,
      "tooltip-format": "{title}",
      "on-click": "minimize-raise",
      "on-click-middle": "close",
      "on-click-right": "maximize",
      "all-outputs": true,
      "ignore-list": [
        "yad"
      ]
    },
    "modules-center": [
      "wlr/taskbar"
    ],
    "pulseaudio": {
      "format": "<span color='@bright-magenta@'>{icon}</span> {volume}%",
      "format-bluetooth": "<span color='@bright-magenta@'>{icon}</span> {volume}%",
      "format-muted": "<span color='@foreground-alt@'>󰝟</span> Muet",
      "format-icons": {
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      },
      "scroll-step": 5.0,
      "tooltip-format": "Volume : {volume}% ({desc})",
      "on-click": "pulsemixer --toggle-mute",
      "on-click-right": "pavucontrol",
      "smooth-scrolling-threshold": 1
    },
    "custom/sep#s1": {
      "format": "",
      "tooltip": false
    },
    "backlight": {
      "format": "<span color='@bright-red@'>{icon}</span> {percent}%",
      "format-icons": [
        "󰃞",
        "󰃟",
        "󰃝",
        "󰃠"
      ],
      "tooltip-format": "Luminosité : {percent}%",
      "on-scroll-up": "light -A 5",
      "on-scroll-down": "light -U 5"
    },
    "custom/sep#s2": {
      "format": "",
      "tooltip": false
    },
    "battery": {
      "interval": 60,
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "<span color='@bright-blue@'>{icon}</span> {capacity}%",
      "format-charging": "<span color='@bright-red@'></span> {capacity}%",
      "format-plugged": "<span color='@bright-red@'></span> {capacity}%",
      "format-full": "<span color='@bright-green@'></span> Chargée",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "format-time": "{H}h{M:02}",
      "tooltip-format": "{timeTo}"
    },
    "custom/sep#s3": {
      "format": "",
      "tooltip": false
    },
    "bluetooth": {
      "format": "<span color='@bright-blue@'></span> {status}",
      "format-on": "<span color='@bright-blue@'></span> Activé",
      "format-off": "<span color='@foreground-alt@'>󰂲</span> Désactivé",
      "format-disabled": "<span color='@foreground-alt@'>󰂲</span> Désactivé",
      "format-connected": "<span color='@bright-blue@'>󰂱</span> {device_alias}",
      "format-connected-battery": "<span color='@bright-blue@'>󰂱</span> {device_alias} {device_battery_percentage}%",
      "format-no-controller": "",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_bluetooth",
      "on-click-right": "blueman-manager"
    },
    "custom/sep#s4": {
      "format": "",
      "tooltip": false
    },
    "network": {
      "interval": 5,
      "format-wifi": "<span color='@bright-yellow@'>󰤨</span> {essid}",
      "format-ethernet": "<span color='@bright-yellow@'>󰈀</span> {ifname}",
      "format-linked": "<span color='@bright-yellow@'>󰈀</span> {ifname} (pas d'IP)",
      "format-disconnected": "<span color='@foreground-alt@'>󰤭</span> Hors ligne",
      "format-disabled": "<span color='@foreground-alt@'>󰤭</span> Désactivé",
      "tooltip-format": "{ifname} · {ipaddr}/{cidr} via {gwaddr}",
      "on-click": "~/.config/labwc/scripts/menu ~/.config/labwc/scripts/rofi_network",
      "on-click-right": "nm-connection-editor"
    },
    "custom/sep#s5": {
      "format": "",
      "tooltip": false
    },
    "clock": {
      "interval": 60,
      "locale": "fr_FR.UTF-8",
      "format": "<span color='@bright-cyan@'></span> {:%H:%M}",
      "format-alt": "<span color='@bright-cyan@'></span> {:%A %d %B %Y}",
      "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/sep#s6": {
      "format": "",
      "tooltip": false
    },
    "tray": {
      "icon-size": 16,
      "spacing": 8
    },
    "modules-right": [
      "pulseaudio",
      "custom/sep#s1",
      "backlight",
      "custom/sep#s2",
      "battery",
      "custom/sep#s3",
      "bluetooth",
      "custom/sep#s4",
      "network",
      "custom/sep#s5",
      "clock",
      "custom/sep#s6",
      "tray"
    ]
  }
]
