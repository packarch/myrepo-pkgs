# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# Configuration of the Packarch desktop: the packarch compositor
# (packarch-rwdesktop, Wayland, floating windows with the look and feel of
# Openbox: Openbox window themes OB-Packarch-*, rc.xml and menu.xml in the
# Openbox format, rounded and shadowed windows and menus, animations) with
# the configuration of the labwc desktop of Packarch (packarch-labwc-settings,
# replaced by this package): the same Wayland tools (waybar, rofi menus, mako,
# hyprlock, swaybg, swayidle, grim and slurp, hyprpicker, kitty), the same
# keys, menu and 10 themes applied by packarch-skin (>= 1.8.0: Packarch
# desktop, XDG_CURRENT_DESKTOP=packarch:wlroots). The configuration goes to
# /etc/skel/.config/packarch (labwc: ~/.config/labwc), with the default
# theme already applied to it at build time (packarch-skin render).
#
# Session: packarch-run (Wayland variables, keyboard layout of the system,
# kitty configuration of the session, Thunar plugins without the wallpaper
# one, configuration copied from /etc/skel at the first start for the
# existing accounts), set as the Exec of packarch.desktop by the
# packarch-session hook; Packarch is the default session of LightDM
# (60-packarch-rwdesktop.conf). labwc itself (labwc-packarch) is not removed:
# its session and ~/.config/labwc stay usable.
#
# 1.0-1: first version, from packarch-labwc-settings 1.0-16

pkgname=packarch-rwdesktop-settings
pkgver=1.0
pkgrel=1
pkgdesc="Configuration of the Packarch desktop (packarch compositor)"
arch=('any')
url="https://github.com/packarch/myrepo-pkgs"
license=('GPL3')
depends=(
  # packarch and the Wayland tools of the configuration
  packarch-rwdesktop labwc-menu-generator swaybg swayidle xorg-xwayland mako waybar rofi
  hyprlock hyprpicker grim slurp wf-recorder wl-clipboard wlr-randr wlopm jq imagemagick
  pulsemixer pavucontrol playerctl light libnotify dex xdg-terminal-exec
  xdg-user-dirs xorg-xhost nwg-look wdisplays waypaper
  xdg-desktop-portal xdg-desktop-portal-wlr xdg-desktop-portal-gtk
  network-manager-applet networkmanager-dmenu-git bluez-utils xfce-polkit
  # applications of the keys and menu
  kitty thunar geany firefox viewnior htop nano yad
  # Geany color schemes of the themes
  packarch-geany-config
  # applications of the Thunar actions
  catfish meld xfconf
  # fonts of waybar, kitty, mako and hyprlock
  noto-fonts ttf-jetbrains-mono-nerd packarch-fonts
  # LightDM greeter, menu hooks, cachy-update
  packarch-system-settings
  # theme chooser, GTK and Openbox (window) themes, icons, cursors and
  # wallpapers
  'packarch-skin>=1.8.0' 'packarch-themes>=2.0-8' 'packarch-icons>=2.0-9'
  'packarch-backgrounds>=2.0-6' packarch-folder-color packarch-cursors
)
# Writes the default theme into /etc/skel (render)
makedepends=('packarch-skin>=1.8.0')
optdepends=(
  'blueman: Bluetooth manager (right click on the Bluetooth module)'
  'kanshi: screen configuration kept (~/.config/kanshi/config, started by autostart)'
)
# The labwc desktop of Packarch is replaced by this one (same Wayland tools,
# files of /etc/skel/.config/autostart and waypaper in common); the Sway one
# before it
replaces=(packarch-labwc-settings packarch-sway-settings)
conflicts=(packarch-labwc-settings packarch-sway-settings)
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
	# The themes of the Openbox desktop (theme.toml only: polybar and rofi
	# layouts are not used), with the thumbnails of the XFCE theme launcher
	local t id themes="$startdir"/../packarch-openbox-settings/files/etc/skel/.config/openbox/themes
	local icons="$startdir"/../packarch-xfce-settings/files/usr/share/xfcethemes/icons
	for t in "$themes"/*/theme.toml; do
		id="$(basename "$(dirname "$t")")"
		install -Dm644 "$t" "$pkgdir"/etc/skel/.config/packarch/themes/"$id"/theme.toml
		if [[ -f "$icons/$id.png" ]]; then
			install -Dm644 "$icons/$id.png" "$pkgdir"/usr/share/packarch/rwdesktop/icons/"$id".png
		fi
	done
	# Icon sets of the menu of the Openbox desktop (scripts/menu-style)
	local set
	for set in "$startdir"/../packarch-openbox-settings/files/usr/share/packarch/openbox/icons/*/; do
		install -Dm644 -t "$pkgdir"/usr/share/packarch/rwdesktop/menu-icons/"$(basename "$set")" "$set"*.png
	done
	install -Dm644 /dev/stdin "$pkgdir"/usr/share/licenses/"$pkgname"/NOTICE <<-EOF
		Wayland tools configuration based on archcraft-sway-free by Aditya
		Shakya (adi1090x), GPL-3.0: https://github.com/archcraft-os/archcraft-sway
	EOF
	# The first session starts with the default theme
	packarch-skin render "$pkgdir" default
}
