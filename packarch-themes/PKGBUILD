# Maintainer: Fabrice Corraire <antidote1911@gmail.com>
#
# GTK, xfwm4 and Openbox themes of the themes of packarch-skin, used by both
# desktops (Openbox and, since packarch-xfce-settings 1.0.9-7, XFCE).
# 2.0-7: content of packarch-themes-openbox (merged, replaced); the former
# GTK themes of the XFCE color switcher (Arc-Dark, Dracula, Greybird-dark,
# Gruvbox, Juno-Mirage, Nordic, Orchis-Red-Dark), used by no theme any more,
# moved to packarch-extra.
#
# Each theme of packarch-skin has its own GTK and Openbox themes,
# Packarch-<Theme> and OB-Packarch-<Theme> (2.0-5), so that a change only
# affects that theme. The originals they come from were renamed (removed);
# Arc-Dark and Juno-Mirage were copied (originals in packarch-extra since
# 2.0-7). Only these 20 themes are shipped: the
# other GTK and Openbox themes, used by no theme, were removed with the
# sweet-gtk-theme dependency (2.0-6). Origins:
#   adaptive       Adapta-Nokto       OB-Adapta-Nokto
#   cyberpunk      Sweet-Dark         OB-Sweet-Dark
#   default        Arc-Dark (copy)    OB-Nordic
#   hacking        Hack               OB-Hack
#   packarch       Manhattan          OB-Manhattan
#   pink-city      Manhattan (copy)   OB-Manhattan (copy)
#   pink-sylvanas  Catppuccin-Mocha   OB-Catppuccin-Mocha
#   red-satanic    Satanic            OB-Kripton
#   spark          Spark              OB-Spark
#   yellow-flower  Juno-Mirage (copy) OB-Juno-Mirage
# Our changes: Manhattan (Materia, GPL2): orange selections and check boxes
# (#f7901e) instead of lilac (#b4a1db), CSS and GTK2 images (packarch-themes
# 2.0-4). Packarch-Red-Satanic: orange accent (#f7901e, shades #e38418 and
# #c97414) instead of grey-blue (#9bbfbf), GTK 2/3/4 (2.0-3); Openbox: red
# accent (#d7263d), light text on the menu highlight (2.0-4).
#
# Files: files/ (installed as is). Most of the content was collected or made
# by Aditya Shakya (adi1090x), GPL3; Packarch-Cyberpunk comes from Sweet-Dark
# (EliverLara, GPL3).

pkgname=packarch-themes
pkgver=2.0
pkgrel=7
pkgdesc="GTK and Openbox themes of Packarch"
arch=('any')
url="https://github.com/packarch/myrepo-pkgs"
license=('GPL3')
provides=(packarch-themes-openbox)
conflicts=(packarch-themes-openbox packarch-gtk-theme-adapta packarch-gtk-theme-arc packarch-gtk-theme-blade packarch-gtk-theme-catppuccin packarch-gtk-theme-cyberpunk packarch-gtk-theme-dracula packarch-gtk-theme-easy packarch-gtk-theme-everforest packarch-gtk-theme-groot packarch-gtk-theme-gruvbox packarch-gtk-theme-hack packarch-gtk-theme-juno packarch-gtk-theme-kripton packarch-gtk-theme-manhattan packarch-gtk-theme-nordic packarch-gtk-theme-rick packarch-gtk-theme-satanic packarch-gtk-theme-slime packarch-gtk-theme-spark packarch-gtk-theme-sweet packarch-gtk-theme-wave packarch-gtk-theme-white packarch-gtk-theme-windows)
replaces=(packarch-themes-openbox packarch-gtk-theme-adapta packarch-gtk-theme-arc packarch-gtk-theme-blade packarch-gtk-theme-catppuccin packarch-gtk-theme-cyberpunk packarch-gtk-theme-dracula packarch-gtk-theme-easy packarch-gtk-theme-everforest packarch-gtk-theme-groot packarch-gtk-theme-gruvbox packarch-gtk-theme-hack packarch-gtk-theme-juno packarch-gtk-theme-kripton packarch-gtk-theme-manhattan packarch-gtk-theme-nordic packarch-gtk-theme-rick packarch-gtk-theme-satanic packarch-gtk-theme-slime packarch-gtk-theme-spark packarch-gtk-theme-sweet packarch-gtk-theme-wave packarch-gtk-theme-white packarch-gtk-theme-windows)
options=(!strip !emptydirs)

package() {
	cp -a "$startdir"/files/. "$pkgdir"/
}
