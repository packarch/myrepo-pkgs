// Barre waybar du thème « pink-city » du bureau Packarch, comme
// sa barre polybar sous Openbox. Copiée dans ~/.config/packarch/waybar/config
// par packarch-skin, qui y remplace les @couleur@ par les couleurs du thème ;
// "@output@" (écran principal) et "@marge15@" : remplis par scripts/statusbar.
[
  {
    "name": "main",
    "output": "@output@",
    "layer": "top",
    "position": "top",
    "height": 38,
    "exclusive": true,
    "fixed-center": true,
    "spacing": 0,
    "reload_style_on_change": true,
    "custom/menu": {
      "format": "<span color='@green@' font_family='packarch'></span>",
      "tooltip-format": "Applications (clic droit : lancer une commande)",
      "on-click": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_launcher",
      "on-click-right": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_runner"
    },
    "custom/dot#d1": {
      "format": "",
      "tooltip": false
    },
    "ext/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "1": "",
        "2": "",
        "3": "",
        "4": ""
      },
      "on-click": "activate",
      "sort-by-id": true,
      "all-outputs": true
    },
    "custom/dot#d2": {
      "format": "",
      "tooltip": false
    },
    "tray": {
      "icon-size": 16,
      "spacing": 8
    },
    "modules-left": [
      "custom/menu",
      "custom/dot#d1",
      "ext/workspaces",
      "custom/dot#d2",
      "tray"
    ],
    "wlr/taskbar": {
      "format": "{icon} {title:.25}",
      "icon-size": 16,
      "tooltip-format": "{title}",
      "on-click": "minimize-raise",
      "on-click-middle": "close",
      "on-click-right": "maximize",
      "all-outputs": true,
      "ignore-list": [
        "yad"
      ]
    },
    "modules-center": [
      "wlr/taskbar"
    ],
    "pulseaudio": {
      "format": "{icon}",
      "format-bluetooth": "{icon}",
      "format-muted": "<span color='@foreground-alt@'>󰝟</span> Muet",
      "format-icons": {
        "default": [
          "<span color='@blue@'>󰕾</span> <span color='@blue@'></span><span color='@foreground-alt@'>━━━━━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━</span><span color='@foreground-alt@'>━━━━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━</span><span color='@foreground-alt@'>━━━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━</span><span color='@foreground-alt@'>━━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━</span><span color='@foreground-alt@'>━━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━</span><span color='@foreground-alt@'>━━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━</span><span color='@foreground-alt@'>━━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━━</span><span color='@foreground-alt@'>━━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━━━</span><span color='@foreground-alt@'>━━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━━━━</span><span color='@foreground-alt@'>━</span>",
          "<span color='@blue@'>󰕾</span> <span color='@blue@'>━━━━━━━━━━</span><span color='@foreground-alt@'></span>"
        ]
      },
      "scroll-step": 5.0,
      "tooltip-format": "Volume : {volume}% ({desc})",
      "on-click": "pulsemixer --toggle-mute",
      "on-click-right": "pavucontrol",
      "smooth-scrolling-threshold": 1
    },
    "custom/dot#d3": {
      "format": "",
      "tooltip": false
    },
    "backlight": {
      "format": "<span color='@cyan@'>{icon}</span> {percent}%",
      "format-icons": [
        "󰃞",
        "󰃟",
        "󰃝",
        "󰃠"
      ],
      "tooltip-format": "Luminosité : {percent}%",
      "on-scroll-up": "light -A 5",
      "on-scroll-down": "light -U 5"
    },
    "custom/dot#d4": {
      "format": "",
      "tooltip": false
    },
    "battery": {
      "interval": 60,
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "<span color='@green@'>{icon}</span> {capacity}%",
      "format-charging": "<span color='@red@'></span> {capacity}%",
      "format-plugged": "<span color='@red@'></span> {capacity}%",
      "format-full": "<span color='@green@'></span> Chargée",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "format-time": "{H}h{M:02}",
      "tooltip-format": "{timeTo}"
    },
    "custom/dot#d5": {
      "format": "",
      "tooltip": false
    },
    "bluetooth": {
      "format": "<span color='@blue@'></span> {status}",
      "format-on": "<span color='@blue@'></span> Activé",
      "format-off": "<span color='@foreground-alt@'>󰂲</span> Désactivé",
      "format-disabled": "<span color='@foreground-alt@'>󰂲</span> Désactivé",
      "format-connected": "<span color='@blue@'>󰂱</span> {device_alias}",
      "format-connected-battery": "<span color='@blue@'>󰂱</span> {device_alias} {device_battery_percentage}%",
      "format-no-controller": "",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_bluetooth",
      "on-click-right": "blueman-manager"
    },
    "custom/dot#d6": {
      "format": "",
      "tooltip": false
    },
    "network": {
      "interval": 5,
      "format-wifi": "<span color='@magenta@'>󰤨</span> {essid}",
      "format-ethernet": "<span color='@magenta@'>󰈀</span> {ifname}",
      "format-linked": "<span color='@magenta@'>󰈀</span> {ifname} (pas d'IP)",
      "format-disconnected": "<span color='@foreground-alt@'>󰤭</span> Hors ligne",
      "format-disabled": "<span color='@foreground-alt@'>󰤭</span> Désactivé",
      "tooltip-format": "{ifname} · {ipaddr}/{cidr} via {gwaddr}",
      "on-click": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_network",
      "on-click-right": "nm-connection-editor"
    },
    "custom/dot#d7": {
      "format": "",
      "tooltip": false
    },
    "clock": {
      "interval": 60,
      "locale": "fr_FR.UTF-8",
      "format": "<span color='@cyan@'></span> <span color='@cyan@'>{:L%H:%M}</span>",
      "format-alt": "<span color='@cyan@'>󰥔</span> {:L%A %d %B %Y}",
      "tooltip-format": "<big>{:L%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/dot#d8": {
      "format": "",
      "tooltip": false
    },
    "custom/power": {
      "format": "<span color='@red@'></span>",
      "tooltip-format": "Éteindre, redémarrer, se déconnecter…",
      "on-click": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_powermenu"
    },
    "modules-right": [
      "pulseaudio",
      "custom/dot#d3",
      "backlight",
      "custom/dot#d4",
      "battery",
      "custom/dot#d5",
      "bluetooth",
      "custom/dot#d6",
      "network",
      "custom/dot#d7",
      "clock",
      "custom/dot#d8",
      "custom/power"
    ]
  }
]
