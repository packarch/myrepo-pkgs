// Barre waybar du thème « packarch » du bureau Packarch, comme
// sa barre polybar sous Openbox. Copiée dans ~/.config/packarch/waybar/config
// par packarch-skin, qui y remplace les @couleur@ par les couleurs du thème ;
// "@output@" (écran principal) et "@marge15@" : remplis par scripts/statusbar.
[
  {
    "name": "top",
    "output": "@output@",
    "layer": "top",
    "position": "top",
    "height": 38,
    "exclusive": true,
    "fixed-center": true,
    "spacing": 0,
    "reload_style_on_change": true,
    "wlr/taskbar": {
      "format": "{icon} {title:.25}",
      "icon-size": 16,
      "tooltip-format": "{title}",
      "on-click": "minimize-raise",
      "on-click-middle": "close",
      "on-click-right": "maximize",
      "all-outputs": true,
      "ignore-list": [
        "yad"
      ]
    },
    "modules-left": [
      "wlr/taskbar"
    ],
    "ext/workspaces": {
      "format": "{icon}",
      "format-icons": {
        "default": "󰊠",
        "active": "󰊠"
      },
      "on-click": "activate",
      "sort-by-id": true,
      "all-outputs": true
    },
    "modules-center": [
      "ext/workspaces"
    ],
    "clock": {
      "interval": 60,
      "locale": "fr_FR.UTF-8",
      "format": "<span color='@cyan@'></span> {:L%H:%M}",
      "format-alt": "<span color='@cyan@'></span> {:L%A %d %B %Y}",
      "tooltip-format": "<big>{:L%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "custom/sep#s1": {
      "format": "",
      "tooltip": false
    },
    "pulseaudio": {
      "format": "<span color='@yellow@'>{icon}</span> {volume}%",
      "format-bluetooth": "<span color='@yellow@'>{icon}</span> {volume}%",
      "format-muted": "<span color='@foreground-alt@'>󰝟</span> Muet",
      "format-icons": {
        "default": [
          "󰕿",
          "󰖀",
          "󰕾"
        ]
      },
      "scroll-step": 5.0,
      "tooltip-format": "Volume : {volume}% ({desc})",
      "on-click": "pulsemixer --toggle-mute",
      "on-click-right": "pavucontrol",
      "smooth-scrolling-threshold": 1
    },
    "custom/sep#s2": {
      "format": "",
      "tooltip": false
    },
    "custom/power": {
      "format": "<span color='@red@'></span>",
      "tooltip-format": "Éteindre, redémarrer, se déconnecter…",
      "on-click": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_powermenu"
    },
    "modules-right": [
      "clock",
      "custom/sep#s1",
      "pulseaudio",
      "custom/sep#s2",
      "custom/power"
    ]
  },
  {
    "name": "main",
    "output": "@output@",
    "layer": "top",
    "position": "bottom",
    "height": 38,
    "exclusive": true,
    "fixed-center": true,
    "spacing": 0,
    "reload_style_on_change": true,
    "custom/menu": {
      "format": "<span color='@accent@'>󰮯</span>",
      "tooltip-format": "Applications (clic droit : lancer une commande)",
      "on-click": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_launcher",
      "on-click-right": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_runner"
    },
    "custom/sep#s3": {
      "format": "",
      "tooltip": false
    },
    "custom/launch-themes": {
      "tooltip-format": "Thèmes Packarch",
      "on-click": "packarch-skin chooser",
      "format": "<span color='@yellow@'>󰏘</span>"
    },
    "custom/sep#s4": {
      "format": "",
      "tooltip": false
    },
    "cpu": {
      "interval": 5,
      "format": "<span color='@green@'>󰍛</span> {usage}%",
      "tooltip": false,
      "on-click": "kitty -e htop"
    },
    "custom/sep#s5": {
      "format": "",
      "tooltip": false
    },
    "memory": {
      "interval": 10,
      "format": "<span color='@cyan@'></span> {percentage}%",
      "tooltip-format": "Mémoire : {used:0.1f} Go / {total:0.1f} Go",
      "on-click": "kitty -e htop"
    },
    "custom/sep#s6": {
      "format": "",
      "tooltip": false
    },
    "temperature": {
      "hwmon-path": "@cpu-temp@",
      "interval": 10,
      "warning-threshold": 75,
      "critical-threshold": 90,
      "format": "<span color='@magenta@'></span> <span color='@green@'>{temperatureC}°C</span>",
      "format-warning": "<span color='@magenta@'></span> <span color='#ff8c1a'>{temperatureC}°C</span>",
      "format-critical": "<span color='@magenta@'></span> <span color='@red@'>{temperatureC}°C</span>",
      "tooltip-format": "Processeur : {temperatureC}°C"
    },
    "modules-left": [
      "custom/menu",
      "custom/sep#s3",
      "custom/launch-themes",
      "custom/sep#s4",
      "cpu",
      "custom/sep#s5",
      "memory",
      "custom/sep#s6",
      "temperature"
    ],
    "group/launchers": {
      "orientation": "horizontal",
      "modules": [
        "custom/launch-firefox",
        "custom/launch-thunar",
        "custom/launch-kitty",
        "custom/launch-discord",
        "custom/launch-filezilla",
        "custom/launch-mkvtoolnix",
        "custom/launch-filebot"
      ]
    },
    "modules-center": [
      "group/launchers"
    ],
    "custom/launch-firefox": {
      "tooltip-format": "Firefox (clic droit : Gmail)",
      "on-click": "firefox",
      "on-click-right": "firefox https://mail.google.com",
      "format": "<span color='@magenta@'></span>"
    },
    "custom/launch-thunar": {
      "tooltip-format": "Fichiers (clic droit : en administrateur)",
      "on-click": "thunar",
      "on-click-right": "~/.config/packarch/scripts/asroot thunar",
      "format": "<span color='@blue@'></span>"
    },
    "custom/launch-kitty": {
      "tooltip-format": "Terminal (clic droit : en administrateur)",
      "on-click": "~/.config/packarch/scripts/kitty",
      "on-click-right": "~/.config/packarch/scripts/asroot 'kitty --class kitty-float --directory /root'",
      "format": "<span color='@green@'></span>"
    },
    "custom/launch-discord": {
      "tooltip-format": "Discord",
      "on-click": "discord",
      "exec": "echo installé",
      "exec-if": "command -v discord",
      "interval": "once",
      "format": "<span color='@cyan@'>󰙯</span>"
    },
    "custom/launch-filezilla": {
      "tooltip-format": "FileZilla",
      "on-click": "filezilla",
      "exec": "echo installé",
      "exec-if": "command -v filezilla",
      "interval": "once",
      "format": "<span color='@yellow@'></span>"
    },
    "custom/launch-mkvtoolnix": {
      "tooltip-format": "MKVToolNix",
      "on-click": "mkvtoolnix-gui",
      "exec": "echo installé",
      "exec-if": "command -v mkvtoolnix-gui",
      "interval": "once",
      "format": "<span color='@red@'></span>"
    },
    "custom/launch-filebot": {
      "tooltip-format": "FileBot",
      "on-click": "filebot",
      "exec": "echo installé",
      "exec-if": "command -v filebot",
      "interval": "once",
      "format": "<span color='@bright-blue@'>󰚩</span>"
    },
    "backlight": {
      "format": "<span color='@cyan@'>{icon}</span> {percent}%",
      "format-icons": [
        "󰃞",
        "󰃟",
        "󰃝",
        "󰃠"
      ],
      "tooltip-format": "Luminosité : {percent}%",
      "on-scroll-up": "light -A 5",
      "on-scroll-down": "light -U 5"
    },
    "custom/sep#s7": {
      "format": "",
      "tooltip": false
    },
    "battery": {
      "interval": 60,
      "states": {
        "warning": 30,
        "critical": 15
      },
      "format": "<span color='@green@'>{icon}</span> {capacity}%",
      "format-charging": "<span color='@red@'></span> {capacity}%",
      "format-plugged": "<span color='@red@'></span> {capacity}%",
      "format-full": "<span color='@green@'></span> Chargée",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "format-time": "{H}h{M:02}",
      "tooltip-format": "{timeTo}"
    },
    "custom/sep#s8": {
      "format": "",
      "tooltip": false
    },
    "bluetooth": {
      "format": "<span color='@blue@'></span> {status}",
      "format-on": "<span color='@blue@'></span> Activé",
      "format-off": "<span color='@foreground-alt@'>󰂲</span> Désactivé",
      "format-disabled": "<span color='@foreground-alt@'>󰂲</span> Désactivé",
      "format-connected": "<span color='@blue@'>󰂱</span> {device_alias}",
      "format-connected-battery": "<span color='@blue@'>󰂱</span> {device_alias} {device_battery_percentage}%",
      "format-no-controller": "",
      "tooltip-format": "{controller_alias}\t{controller_address}",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "on-click": "~/.config/packarch/scripts/menu ~/.config/packarch/scripts/rofi_bluetooth",
      "on-click-right": "blueman-manager"
    },
    "custom/sep#s9": {
      "format": "",
      "tooltip": false
    },
    "tray": {
      "icon-size": 16,
      "spacing": 8
    },
    "modules-right": [
      "backlight",
      "custom/sep#s7",
      "battery",
      "custom/sep#s8",
      "bluetooth",
      "custom/sep#s9",
      "tray"
    ]
  }
]
