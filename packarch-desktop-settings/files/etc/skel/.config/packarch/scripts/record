#!/usr/bin/env bash

## Copyright (C) 2020-2026 Aditya Shakya <adi1090x@gmail.com>
##
## Packarch : enregistreur d'écran du menu de Packarch (« Enregistreur d'écran »),
## comme le pipemenu pa-record d'Openbox (ffmpeg et slop, X11 seulement),
## avec wf-recorder et slurp sous Wayland :
##   record                  pipemenu (avec « Arrêter » pendant un enregistrement)
##   record --screen[-na]    un écran, choisi d'un clic (-na : sans le son)
##   record --area[-na]      une zone sélectionnée (-na : sans le son)
##   record --stop           arrête l'enregistrement en cours
## Vidéos dans Vidéos/Screenrecorder. Le son est celui de l'ordinateur
## (moniteur de la sortie audio par défaut).

DIR="$HOME/.config/packarch"
iDIR="$DIR/mako/icons"
background="$(grep 'background:' "$DIR/rofi/shared/colors.rasi" 2>/dev/null | head -1 | cut -d':' -f2 | tr -d ' ;')"
accent="$(grep 'selected:' "$DIR/rofi/shared/colors.rasi" 2>/dev/null | head -1 | cut -d':' -f2 | tr -d ' ;')"
background="${background:-#101012}"
accent="${accent:-#f8c602}"

dir="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Vidéos")/Screenrecorder"
file="$dir/Capture_$(date +%Y-%m-%d-%H-%M-%S).mp4"

notify() {
	notify-send -u low -h string:x-canonical-private-synchronous:packarch-record -i "$iDIR/video.png" "$@"
}

countdown() {
	local sec
	for ((sec = $1; sec > 0; sec--)); do
		notify-send -t 1000 -h string:x-canonical-private-synchronous:packarch-record-timer -i "$iDIR/timer.png" "Début dans : $sec"
		sleep 1
	done
}

slurp_cmd() {
	slurp "$@" -b "${background:1}CC" -c "${accent:1}ff" -s "${accent:1}0D" -w 2
}

# record écran|zone [noaudio]
record() {
	local target audio=()
	if [[ $1 == screen ]]; then
		# Nom de l'écran cliqué
		target="$(slurp_cmd -o -f '%o')" || exit 0
		target=(-o "$target")
	else
		target="$(slurp_cmd)" || exit 0
		target=(-g "$target")
	fi
	if [[ $2 != noaudio ]]; then
		local sink
		sink="$(pactl get-default-sink 2>/dev/null)"
		audio=("--audio=${sink:+$sink.monitor}")
		[[ -n $sink ]] || audio=(--audio)
	fi
	mkdir -p "$dir"
	countdown 3
	notify "Enregistrement en cours (menu : Arrêter l’enregistrement)"
	wf-recorder "${target[@]}" "${audio[@]}" -r 25 -f "$file" </dev/null >/dev/null 2>&1
	if [[ -s $file ]]; then
		notify "Enregistrée dans $dir"
	else
		rm -f "$file"
		notify "Vidéo supprimée."
	fi
}

# Échappement XML des attributs du pipemenu
item() {
	local cmd="${2//&/&amp;}"
	cmd="${cmd//\"/&quot;}"
	printf '  <item label="%s" icon="%s"><action name="Execute" command="%s" /></item>\n' "$1" "$3" "$cmd"
}

case "${1:-}" in
	--screen) record screen ;;
	--screen-na) record screen noaudio ;;
	--area) record area ;;
	--area-na) record area noaudio ;;
	# SIGINT : wf-recorder termine proprement le fichier
	--stop) pkill -INT -u "$UID" -x wf-recorder ;;
	"")
		self="sh -c '~/.config/packarch/scripts/record"
		echo '<openbox_pipe_menu>'
		if pgrep -u "$UID" -x wf-recorder >/dev/null; then
			item 'Arrêter l’enregistrement' "$self --stop'" media-playback-stop
			echo '  <separator />'
		fi
		item 'Enregistrer un écran (avec le son)' "$self --screen'" video-display
		item 'Enregistrer un écran (sans le son)' "$self --screen-na'" video-display
		item 'Enregistrer une zone (avec le son)' "$self --area'" edit-select
		item 'Enregistrer une zone (sans le son)' "$self --area-na'" edit-select
		echo '</openbox_pipe_menu>'
		;;
	*)
		echo "usage : record [--screen|--screen-na|--area|--area-na|--stop]" >&2
		exit 2
		;;
esac

exit 0
