#!/usr/bin/env bash

## Packarch : actions « Définir comme fond d'écran » et « Définir comme écran
## de verrouillage » de Thunar (/usr/share/packarch/desktop/uca.xml) :
##   image --wallpaper FICHIER [MODE [COULEUR]]
##                                fond d'écran de tous les écrans (wallpaper) ;
##                                MODE et COULEUR : ceux de waypaper (menu
##                                « Changer de fond d'écran », post_command)
##   image --lockscreen FICHIER   fond de hyprlock (hyprlock.conf)
## Les fichiers modifiés sont ceux qu'écrit packarch-skin : changer de thème
## remet le fond d'écran et l'écran de verrouillage du thème.

dir="$HOME/.config/packarch"
notify() {
	notify-send -u "$1" -h string:x-canonical-private-synchronous:packarch-image "$2"
}

file="$2"
if [[ ! -f $file ]]; then
	notify critical "Image introuvable : $file"
	exit 1
fi
file="$(realpath -- "$file")"
# Retours à la ligne : impossibles dans les fichiers d'une ligne
if [[ $file == *$'\n'* ]]; then
	notify critical "Nom de fichier non pris en charge : $file"
	exit 1
fi

case "$1" in
	--wallpaper)
		# Mode et couleur de swaybg (fill et noir par défaut)
		mode="${3,,}" color="$4"
		[[ $mode =~ ^(fill|fit|stretch|center|tile)$ ]] || mode=fill
		[[ $color =~ ^#[0-9A-Fa-f]{6}$ ]] || color='#000000'
		printf '%s\n%s\n%s\n' "$file" "$mode" "$color" > "$dir/wallpaper"
		"$dir/scripts/wallpaper"
		notify low "Fond d'écran : ${file##*/}"
		;;
	--lockscreen)
		# Pour sed : \, & et | du chemin protégés
		esc="$(printf '%s' "$file" | sed 's/[\\&|]/\\&/g')"
		sed -i "s|^\$wallpaper = .*|\$wallpaper = $esc|" "$dir/hyprlock.conf"
		notify low "Écran de verrouillage : ${file##*/}"
		;;
	*)
		echo "usage : image --wallpaper FICHIER [MODE [COULEUR]] | --lockscreen FICHIER" >&2
		exit 2
		;;
esac
